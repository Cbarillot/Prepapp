                      <textarea onchange="app.updateBrainstormCard('${c.id}', 'text', this.value)" rows="2"
                                placeholder="Détails de l'idée..."
                                class="w-full text-xs text-stone-600 bg-stone-50 p-1.5 rounded border border-stone-200/70 focus:outline-none">${c.text || ''}</textarea>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        } else {
          const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
          if (!activeTab || activeTab.type !== 'seance') {
            container.innerHTML = `
              <div class="p-4 text-center text-xs text-stone-500 theme-card border">
                Ouvrez une fiche de <b>Séance</b> au centre pour gérer sa checklist de préparation et ses liens avec les autres séances.
              </div>
            `;
          } else {
            const { seq, sea } = this.getSeance(activeTab.seqId, activeTab.seaId);
            if (!sea.checklist) sea.checklist = { supportsPrets: false, diapoPret: false, realisee: false };

            const otherSeances = [];
            this.data.sequences.forEach(s => {
              s.seances.forEach(se => {
                if (se.id !== sea.id) otherSeances.push({ seq: s, sea: se });
              });
            });

            container.innerHTML = `
              <div class="theme-card p-3.5 border shadow-2xs space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 block">État de préparation</span>
                <label class="flex items-center gap-2 text-xs text-stone-700 cursor-pointer">
                  <input type="checkbox" ${sea.checklist.supportsPrets ? 'checked' : ''}
                         onchange="app.toggleChecklist('${seq.id}', '${sea.id}', 'supportsPrets', this.checked)" class="rounded">
                  <span>Supports & polycopiés prêts</span>
                </label>
                <label class="flex items-center gap-2 text-xs text-stone-700 cursor-pointer">
                  <input type="checkbox" ${sea.checklist.diapoPret ? 'checked' : ''}
                         onchange="app.toggleChecklist('${seq.id}', '${sea.id}', 'diapoPret', this.checked)" class="rounded">
                  <span>Diaporama / Médias prêts</span>
                </label>
                <label class="flex items-center gap-2 text-xs text-stone-700 cursor-pointer">
                  <input type="checkbox" ${sea.checklist.realisee ? 'checked' : ''}
                         onchange="app.toggleChecklist('${seq.id}', '${sea.id}', 'realisee', this.checked)" class="rounded">
                  <span class="font-semibold text-emerald-800">Séance réalisée en classe</span>
                </label>
              </div>

              <div class="theme-card p-3.5 border shadow-2xs space-y-2.5">
                <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 block">Séances liées (Arborescence croisée)</span>
                <div class="space-y-1.5">
                  ${(sea.liens || []).map(linkedId => {
                    const found = this.findSeanceById(linkedId);
                    if (!found) return '';
                    const st = this.getDominanteStyle(found.sea.dominante);
                    return `
                      <div class="flex items-center justify-between gap-2 p-2 rounded-lg border text-xs"
                           style="background-color: ${st.bgSoft}; border-color: ${st.borderSoft}">
                        <button onclick="app.openTab({ id: 'tab-${found.sea.id}', type: 'seance', seqId: '${found.seq.id}', seaId: '${found.sea.id}' }, true)"
                                class="text-left font-medium text-stone-900 hover:underline truncate flex-1">
                          🔗 ${found.sea.titre}
                        </button>
                        <button onclick="app.removeLink('${seq.id}', '${sea.id}', '${linkedId}')" class="text-stone-400 hover:text-rose-600"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
                      </div>
                    `;
                  }).join('') || `<p class="text-xs text-stone-400 italic">Aucune séance liée.</p>`}
                </div>

                <div class="pt-2 border-t border-stone-100">
                  <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">Lier une autre séance :</label>
                  <select onchange="if(this.value) { app.addLink('${seq.id}', '${sea.id}', this.value); this.value=''; }"
                          class="w-full text-xs bg-stone-50 border border-stone-300 rounded-lg p-1.5">
                    <option value="">+ Choisir une séance...</option>
                    ${otherSeances.map(({ seq: s, sea: se }) => `<option value="${se.id}">${s.code} — ${se.titre}</option>`).join('')}
                  </select>
                </div>
              </div>
            `;
          }
        }
        lucide.createIcons();
      },

      // --- ACTIONS CRUD SUR PA, SÉANCES, BRAINSTORMING ---
      getSequence(seqId) {
        return this.data.sequences.find(s => s.id === seqId);
      },

      getSeance(seqId, seaId) {
        const seq = this.getSequence(seqId);
        if (!seq) return { seq: null, sea: null };
        const sea = seq.seances.find(s => s.id === seaId);
        return { seq, sea };
      },

      findSeanceById(seaId) {
        for (const seq of this.data.sequences) {
          const sea = seq.seances.find(s => s.id === seaId);
          if (sea) return { seq, sea };
        }
        return null;
      },

      updateSeqField(seqId, field, value) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        seq[field] = value;
        this.saveData();
        this.renderTree();
        this.renderTabs();
      },

      updateSeaField(seqId, seaId, field, value) {
        const { sea } = this.getSeance(seqId, seaId);
        if (!sea) return;
        sea[field] = value;
        this.saveData();
        this.renderTree();
        this.renderTabs();
      },

      createSequence() {
        const num = this.data.sequences.length + 1;
        const newSeq = {
          id: 'pa-' + Date.now(),
          code: `PA ${num}`,
          titre: `Nouveau Projet d'Apprentissage ${num}`,
          entree: "Entrée littéraire...",
          competencePrincipale: "Lecture",
          dureePrevue: "Prévue : 3 semaines",
          questionnement: "",
          objectifGeneral: "",
          corpus: "",
          evaluationSommative: "",
          competencesTravaillees: "",
          medias: [],
          seances: []
        };
        this.data.sequences.push(newSeq);
        this.saveData();
        this.openTab({ id: `tab-${newSeq.id}`, type: 'sequence', seqId: newSeq.id }, true);
      },

      deleteSequence(seqId) {
        this.data.sequences = this.data.sequences.filter(s => s.id !== seqId);
        this.openTabs = this.openTabs.filter(t => t.seqId !== seqId);
        if (this.activeTabId === `tab-${seqId}`) {
          this.activeTabId = this.openTabs[0]?.id || null;
        }
        this.saveData();
        this.renderAll();
      },

      createSeance(seqId) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        const num = seq.seances.length + 1;
        const newSea = {
          id: 'sea-' + Date.now(),
          numero: `S${num}`,
          titre: `S${num} - Nouvelle séance`,
          dominante: "Lecture",
          dateDebut: new Date().toISOString().slice(0, 10),
          dateFin: new Date().toISOString().slice(0, 10),
          dureePrevue: "1h",
          dureeReelle: "",
          objectifs: "",
          competences: "",
          miseEnOeuvre: "<h3>1. Mise en activité (10 min)</h3><p>Description...</p><h3>2. Analyse / Activité centrale (35 min)</h3><p>Description...</p><h3>3. Trace écrite (10 min)</h3><p>Synthèse...</p>",
          vigilance: "",
          supports: "",
          devoirs: "",
          notes: "",
          liens: [],
          medias: [],
          checklist: { supportsPrets: false, diapoPret: false, realisee: false }
        };
        seq.seances.push(newSea);
        this.saveData();
        this.openTab({ id: `tab-${newSea.id}`, type: 'seance', seqId: seq.id, seaId: newSea.id }, true);
      },

      deleteSeance(seqId, seaId) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        seq.seances = seq.seances.filter(s => s.id !== seaId);
        this.openTabs = this.openTabs.filter(t => t.seaId !== seaId);
        if (this.activeTabId === `tab-${seaId}`) {
          this.activeTabId = `tab-${seqId}`;
        }
        this.saveData();
        this.renderAll();
      },

      addBrainstormCard() {
        if (!this.data.brainstorming.cards) this.data.brainstorming.cards = [];
        this.data.brainstorming.cards.unshift({
          id: 'idea-' + Date.now(),
          category: 'Idée',
          color: '#f59e0b',
          title: 'Nouvelle piste pédagogique',
          text: ''
        });
        this.saveData();
        this.renderRightSidebar();
        if (this.currentMainView === 'brainstorm') this.renderViewport();
      },

      updateBrainstormCard(id, field, val) {
        const card = this.data.brainstorming.cards.find(c => c.id === id);
        if (card) {
          card[field] = val;
          this.saveData();
        }
      },

      deleteBrainstormCard(id) {
        this.data.brainstorming.cards = this.data.brainstorming.cards.filter(c => c.id !== id);
        this.saveData();
        this.renderRightSidebar();
        if (this.currentMainView === 'brainstorm') this.renderViewport();
      },

      toggleChecklist(seqId, seaId, key, val) {
        const { sea } = this.getSeance(seqId, seaId);
        if (!sea) return;
        if (!sea.checklist) sea.checklist = {};
        sea.checklist[key] = val;
        this.saveData();
      },

      addLink(seqId, seaId, targetSeaId) {
        const { sea } = this.getSeance(seqId, seaId);
        if (!sea) return;
        if (!sea.liens) sea.liens = [];
        if (!sea.liens.includes(targetSeaId)) {
          sea.liens.push(targetSeaId);
          this.saveData();
          this.renderRightSidebar();
        }
      },

      removeLink(seqId, seaId, targetSeaId) {
        const { sea } = this.getSeance(seqId, seaId);
        if (!sea) return;
        sea.liens = (sea.liens || []).filter(id => id !== targetSeaId);
        this.saveData();
        this.renderRightSidebar();
      },

      // --- EXPORT EN WORD (.DOC) MODIFIABLE ---
      exportActiveToDoc() {
        const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
        let docTitle = "Export_Programmation";
        let bodyContent = "";

        if (this.currentMainView === 'workspace' && activeTab && activeTab.type === 'sequence') {
          const seq = this.getSequence(activeTab.seqId);
          docTitle = `${seq.code}_${seq.titre}`;
          bodyContent = `
            <h1>${seq.code} — ${seq.titre}</h1>
            <p><b>Entrée littéraire :</b> ${seq.entree || ''} | <b>Compétence principale :</b> ${seq.competencePrincipale || ''} | <b>Durée :</b> ${seq.dureePrevue || ''}</p>
            <p><b>Questionnement :</b> <i>${seq.questionnement || ''}</i></p>
            <h2>Objectif général</h2>
            <p>${(seq.objectifGeneral || '').replace(/\n/g, '<br>')}</p>
            <h2>Corpus</h2>
            <p>${(seq.corpus || '').replace(/\n/g, '<br>')}</p>
            <h2>Évaluation sommative</h2>
            <p>${(seq.evaluationSommative || '').replace(/\n/g, '<br>')}</p>
            <h2>Compétences travaillées</h2>
            <p>${(seq.competencesTravaillees || '').replace(/\n/g, '<br>')}</p>
          `;
        } else if (this.currentMainView === 'workspace' && activeTab && activeTab.type === 'seance') {
          const { seq, sea } = this.getSeance(activeTab.seqId, activeTab.seaId);
          docTitle = sea.titre;
          bodyContent = `
            <p style="color:#78716c;"><b>${seq.code} — ${seq.titre}</b></p>
            <h1>${sea.titre}</h1>
            <p><b>Dominante :</b> ${sea.dominante} | <b>Dates :</b> ${sea.dateDebut || '—'} au ${sea.dateFin || '—'} | <b>Durée :</b> ${sea.dureePrevue || '—'}</p>
            <h3>Objectifs</h3>
            <p>${(sea.objectifs || '').replace(/\n/g, '<br>')}</p>
            <h3>Compétences</h3>
            <p>${(sea.competences || '').replace(/\n/g, '<br>')}</p>
            <h3>Mise en œuvre / Déroulement</h3>
            <div>${sea.miseEnOeuvre || ''}</div>
            <h3>Points de vigilance / Adaptations & variantes</h3>
            <p>${(sea.vigilance || '').replace(/\n/g, '<br>')}</p>
            <h3>À préparer / Supports</h3>
            <p>${(sea.supports || '').replace(/\n/g, '<br>')}</p>
            <h3>Devoirs / Prolongement</h3>
            <p>${(sea.devoirs || '').replace(/\n/g, '<br>')}</p>
            <h3>Notes & Bilan (5A / 5C)</h3>
            <p>${(sea.notes || '').replace(/\n/g, '<br>')}</p>
          `;
        } else {
          docTitle = "Programmation_5eme";
          bodyContent = document.getElementById('editor-viewport').innerHTML;
        }

        const htmlDoc = `
          <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
          <head><meta charset='utf-8'><title>${docTitle}</title></head>
          <body style="font-family: Calibri, Arial, sans-serif; font-size: 11pt; line-height: 1.5;">${bodyContent}</body></html>
        `;

        const blob = new Blob(['\ufeff', htmlDoc], { type: 'application/msword' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${docTitle.replace(/[^a-z0-9àâçéèêëîïôûùüÿñæœ_-]/gi, '_')}.doc`;
        a.click();
        URL.revokeObjectURL(url);
      },

      // --- SAUVEGARDE DIRECTE SUR LE DISQUE / DOSSIER GOOGLE DRIVE LOCAL ---
      async syncToDiskFile() {
        try {
          if ('showSaveFilePicker' in window) {
            if (!this.fileHandle) {
              this.fileHandle = await window.showSaveFilePicker({
                suggestedName: 'Programmation_5eme_Sauvegarde.json',
                types: [{ description: 'Fichier JSON', accept: { 'application/json': ['.json'] } }]
              });
            }
            const writable = await this.fileHandle.createWritable();
            await writable.write(JSON.stringify(this.data, null, 2));
            await writable.close();
            document.getElementById('disk-file-label').textContent = `Synchronisé (${this.fileHandle.name})`;
            document.getElementById('save-time').textContent = `Disque OK`;
          } else {
            this.exportJSON();
          }
        } catch (err) {
          if (err.name !== 'AbortError') {
            this.exportJSON();
          }
        }
      },

      exportJSON() {
        const blob = new Blob([JSON.stringify(this.data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Programmation_5eme_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      },

      importJSON(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const parsed = JSON.parse(e.target.result);
            if (parsed && parsed.sequences) {
              this.data = parsed;
              if (!this.data.dominantes) this.data.dominantes = JSON.parse(JSON.stringify(DEFAULT_DOMINANTES));
              this.saveData();
              this.applyAppearanceToDOM();
              this.renderAll();
            }
          } catch (err) {
            console.error("Fichier JSON invalide", err);
          }
        };
        reader.readAsText(file);
      },

      resetToGoogleSheetData() {
        this.data = JSON.parse(JSON.stringify(INITIAL_DATA));
        this.saveData();
        this.applyAppearanceToDOM();
        this.openTabs = [];
        this.openTab({ id: 'tab-pa-2', type: 'sequence', seqId: 'pa-2' }, false);
        this.openTab({ id: 'tab-sea-c2-1', type: 'seance', seqId: 'pa-2', seaId: 'sea-c2-1' }, true);
        this.renderAll();
      },

      setupKeyboardShortcuts() {
        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            this.saveData();
            if (this.fileHandle) this.syncToDiskFile();
          } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey) {
            // Laisser le navigateur gérer l'undo natif si on est dans un champ texte, sinon undo applicatif
            const activeEl = document.activeElement;
            if (!activeEl || (!activeEl.isContentEditable && activeEl.tagName !== 'INPUT' && activeEl.tagName !== 'TEXTAREA')) {
              e.preventDefault();
              this.undo();
            }
          } else if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) {
            const activeEl = document.activeElement;
            if (!activeEl || (!activeEl.isContentEditable && activeEl.tagName !== 'INPUT' && activeEl.tagName !== 'TEXTAREA')) {
              e.preventDefault();
              this.redo();
            }
          }
        });
      },

      formatDateShort(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        return d.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
      },

      escapeAttr(str) {
        return String(str || '').replace(/"/g, '&quot;');
      },

      renderAll() {
        this.renderTree();
        this.renderTabs();
        this.renderViewport();
        this.renderRightSidebar();
        this.updateUndoRedoButtons();
      }
    };

    window.addEventListener('DOMContentLoaded', () => app.init());
  </script>
</body>
</html>
