<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atelier Pédagogique 5ème — Projets d'Apprentissage & Séances</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    :root {
      --bg-main: #FAF8F5;
      --bg-sidebar: #F3EFEA;
      --bg-card: #FFFFFF;
      --bg-header: #1C1917;
      --text-header: #F5F5F4;
      --text-main: #292524;
      --accent: #B45309;
      --accent-soft: #FEF3C7;
      --border-color: #E7E5E4;
      --editor-font: 'Inter', sans-serif;
      --title-font: 'Lora', serif;
      --editor-size: 15px;
      --card-radius: 12px;
      --content-max-width: 1024px;
    }

    body {
      font-family: var(--editor-font);
      background-color: var(--bg-main);
      color: var(--text-main);
    }

    .font-serif-title {
      font-family: var(--title-font);
    }

    .theme-header {
      background-color: var(--bg-header);
      color: var(--text-header);
    }

    .theme-sidebar {
      background-color: var(--bg-sidebar);
      border-color: var(--border-color);
    }

    .theme-card {
      background-color: var(--bg-card);
      border-color: var(--border-color);
      border-radius: var(--card-radius);
    }

    .theme-accent-btn {
      background-color: var(--accent);
      color: #ffffff;
    }
    .theme-accent-btn:hover {
      filter: brightness(1.08);
    }

    .content-container {
      max-width: var(--content-max-width);
    }

    /* Zone d'édition riche */
    .rich-editor {
      font-family: var(--editor-font);
      font-size: var(--editor-size);
      line-height: 1.65;
      min-height: 240px;
      outline: none;
    }
    .rich-editor ul { list-style-type: disc; padding-left: 1.5rem; margin: 0.4rem 0; }
    .rich-editor ol { list-style-type: decimal; padding-left: 1.5rem; margin: 0.4rem 0; }
    .rich-editor h3 { font-weight: 700; font-size: 1.15em; margin-top: 0.75rem; margin-bottom: 0.25rem; color: var(--accent); font-family: var(--title-font); }
    .rich-editor blockquote { border-left: 4px solid var(--accent); padding-left: 0.75rem; color: #57534e; font-style: italic; margin: 0.5rem 0; background: var(--accent-soft); padding: 0.6rem 0.85rem; border-radius: 0.35rem; }

    /* Poignées de redimensionnement */
    .resizer {
      width: 5px;
      cursor: col-resize;
      background-color: transparent;
      transition: background-color 0.15s ease;
      z-index: 20;
    }
    .resizer:hover, .resizer.active {
      background-color: var(--accent);
    }

    /* Scrollbars discrètes */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #a8a29e; }

    /* Impression / Export PDF propre */
    @media print {
      .no-print { display: none !important; }
      body, html, #app-root, #main-workspace {
        height: auto !important;
        overflow: visible !important;
        background: white !important;
      }
      .print-container {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col select-none" id="app-root">

  <!-- BARRE SUPÉRIEURE GLOBALE ÉPURÉE & NAVIGATION DE VUES -->
  <header class="no-print h-14 theme-header px-3 py-1.5 flex items-center justify-between border-b border-stone-800/40 shrink-0 shadow-sm z-30">
    <!-- Gauche : Repli panneau + Identité personnalisable -->
    <div class="flex items-center gap-2.5 min-w-0">
      <button onclick="app.toggleLeftSidebar()" title="Afficher/Masquer l'arborescence (Gauche)" class="p-1.5 rounded-lg hover:bg-white/10 transition">
        <i data-lucide="panel-left" class="w-4 h-4"></i>
      </button>

      <div onclick="app.openModal('theme-modal')" class="flex items-center gap-2 cursor-pointer group px-2 py-1 rounded-lg hover:bg-white/10 transition" title="Cliquer pour personnaliser le titre, l'icône ou le thème">
        <span id="site-icon-display" class="text-lg leading-none">📚</span>
        <div class="truncate">
          <h1 id="site-title-display" class="font-serif-title font-semibold text-sm md:text-base tracking-wide truncate">Atelier Pédagogique 5ème</h1>
          <p id="site-subtitle-display" class="text-[10px] opacity-75 truncate hidden sm:block">Programmation & Séquences</p>
        </div>
      </div>
    </div>

    <!-- Centre : Commutateur de Vues Clair (3 Vues distinctes + Retour vue précédente) -->
    <div class="flex items-center gap-1 bg-black/25 p-1 rounded-xl border border-white/10">
      <button onclick="app.switchMainView('workspace')" id="nav-btn-workspace"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
        <span>Projets & Séances</span>
      </button>
      <button onclick="app.switchMainView('calendar')" id="nav-btn-calendar"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i>
        <span>Calendrier & Tableau</span>
      </button>
      <button onclick="app.switchMainView('brainstorm')" id="nav-btn-brainstorm"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="lightbulb" class="w-3.5 h-3.5"></i>
        <span>Mur de Brainstorming</span>
      </button>
    </div>

    <!-- Droite : Annuler/Rétablir + Studio Apparence + Tags + Panneau droit -->
    <div class="flex items-center gap-1.5">
      <!-- Boutons Annuler / Rétablir (Undo / Redo) -->
      <div class="flex items-center bg-black/20 rounded-lg p-0.5 border border-white/10 mr-1">
        <button onclick="app.undo()" id="btn-undo" title="Annuler la dernière modification (Ctrl+Z)" class="p-1.5 rounded hover:bg-white/10 disabled:opacity-30 transition">
          <i data-lucide="undo-2" class="w-3.5 h-3.5"></i>
        </button>
        <button onclick="app.redo()" id="btn-redo" title="Rétablir la modification (Ctrl+Y)" class="p-1.5 rounded hover:bg-white/10 disabled:opacity-30 transition">
          <i data-lucide="redo-2" class="w-3.5 h-3.5"></i>
        </button>
      </div>

      <!-- Bouton Gestion des Tags Dominantes -->
      <button onclick="app.openModal('tags-modal')" title="Gérer et colorer les tags de dominantes" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-white/10 hover:bg-white/20 flex items-center gap-1.5 transition">
        <i data-lucide="tags" class="w-3.5 h-3.5"></i>
        <span class="hidden lg:inline">Dominantes</span>
      </button>

      <!-- Bouton Studio de Mise en forme & Thèmes -->
      <button onclick="app.openModal('theme-modal')" title="Personnaliser le thème, les couleurs, la police et la mise en page" class="px-2.5 py-1.5 rounded-lg text-xs font-medium theme-accent-btn flex items-center gap-1.5 shadow-sm transition">
        <i data-lucide="palette" class="w-3.5 h-3.5"></i>
        <span class="hidden md:inline"> Apparence & Mise en forme</span>
      </button>

      <!-- Indicateur discret de sauvegarde -->
      <span id="save-indicator" class="hidden xl:flex items-center gap-1 text-[11px] text-emerald-300 px-2">
        <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
        <span id="save-time">Sauvegardé</span>
      </span>

      <button onclick="app.toggleRightSidebar()" title="Afficher/Masquer le panneau latéral droit (Notes & Liens)" class="p-1.5 rounded-lg hover:bg-white/10 transition">
        <i data-lucide="panel-right" class="w-4 h-4"></i>
      </button>
    </div>
  </header>

  <!-- BANNIÈRE DÉCORATIVE OPTIONNELLE -->
  <div id="custom-banner" class="no-print hidden h-24 w-full bg-cover bg-center relative border-b border-stone-300 shrink-0">
    <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-black/25 to-transparent flex items-end p-3">
      <span id="banner-caption" class="text-white text-xs font-serif-title italic drop-shadow"></span>
    </div>
  </div>

  <!-- CORPS DE L'APPLICATION (3 COLONNES REDIMENSIONNABLES) -->
  <div class="flex-1 flex overflow-hidden select-text">

    <!-- 1. BARRE LATÉRALE GAUCHE : ARBORESCENCE DES PROJETS D'APPRENTISSAGE & SÉANCES COLORÉES -->
    <aside id="left-sidebar" style="width: 320px;" class="no-print theme-sidebar border-r flex flex-col shrink-0 transition-none overflow-hidden">
      <div class="p-3 border-b border-stone-200/80 space-y-2.5">
        <div class="flex items-center justify-between">
          <span id="label-sidebar-pa" onclick="app.promptRenameLabel('sidebarPA', 'Titre de la colonne de gauche :')" class="text-xs font-bold uppercase tracking-wider text-stone-500 cursor-pointer hover:text-stone-800 flex items-center gap-1" title="Cliquer pour renommer cet intitulé">
            <span>Projets d'Apprentissage</span>
            <i data-lucide="edit-3" class="w-3 h-3 opacity-40"></i>
          </span>
          <button onclick="app.createSequence()" class="px-2.5 py-1 rounded-lg theme-accent-btn text-xs font-medium flex items-center gap-1 shadow-sm transition">
            <i data-lucide="folder-plus" class="w-3.5 h-3.5"></i>
            <span>Nouveau PA</span>
          </button>
        </div>

        <!-- Recherche -->
        <div class="relative">
          <input type="text" id="tree-search" oninput="app.renderTree()" placeholder="Rechercher un PA, une séance..." class="w-full pl-7 pr-2 py-1.5 text-xs bg-white border border-stone-300 rounded-lg focus:outline-none focus:border-amber-600">
          <i data-lucide="search" class="w-3.5 h-3.5 text-stone-400 absolute left-2.5 top-2"></i>
        </div>

        <!-- Filtres dynamiques par dominante + bouton d'édition des tags -->
        <div class="flex items-center gap-1 flex-wrap pt-0.5" id="dominante-filters"></div>
      </div>

      <!-- Liste Arborescente avec surlignage pastel des titres de séances -->
      <div id="tree-container" class="flex-1 overflow-y-auto p-2.5 space-y-2.5"></div>

      <!-- Pied de barre gauche -->
      <div class="p-2.5 border-t border-stone-200/80 bg-black/5 flex items-center justify-between text-[11px] text-stone-600">
        <span id="stats-counter">3 PA • 6 séances</span>
        <button onclick="app.resetToGoogleSheetData()" class="underline hover:text-amber-800" title="Recharger les données initiales du Google Sheet">Données Sheet initiales</button>
      </div>
    </aside>

    <!-- POIGNÉE DE REDIMENSIONNEMENT GAUCHE -->
    <div id="resizer-left" class="resizer no-print"></div>

    <!-- 2. ZONE CENTRALE : ONGLETS ÉPURÉS & CONTENU DE LA VUE ACTIVE -->
    <main id="main-workspace" class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Barre d'onglets ouverts (uniquement visible en vue Projets & Séances, allégée sans les gros boutons d'export) -->
      <div id="workspace-tabs-header" class="no-print bg-black/5 border-b border-stone-300/80 px-3 pt-1.5 flex items-center justify-between gap-2 shrink-0">
        <div id="tabs-bar" class="flex items-center gap-1.5 overflow-x-auto flex-1 py-0.5"></div>
      </div>

      <!-- Contenu dynamique central -->
      <div id="editor-viewport" class="flex-1 overflow-y-auto p-5 md:p-7"></div>
    </main>

    <!-- POIGNÉE DE REDIMENSIONNEMENT DROITE -->
    <div id="resizer-right" class="resizer no-print"></div>

    <!-- 3. BARRE LATÉRALE DROITE : BRAINSTORMING RAPIDE & MAILLAGE -->
    <aside id="right-sidebar" style="width: 340px;" class="no-print theme-sidebar border-l flex flex-col shrink-0 transition-none overflow-hidden">
      <div class="flex border-b border-stone-200/80 bg-black/5 p-1 gap-1">
        <button onclick="app.setRightTab('brainstorm')" id="rtab-brainstorm" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 bg-white text-stone-900 shadow-sm">
          <i data-lucide="lightbulb" class="w-3.5 h-3.5 text-amber-600"></i>
          <span>Notes & Idées</span>
        </button>
        <button onclick="app.setRightTab('links')" id="rtab-links" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 text-stone-600 hover:text-stone-900">
          <i data-lucide="git-branch" class="w-3.5 h-3.5"></i>
          <span>Maillage & Suivi</span>
        </button>
      </div>

      <div id="right-sidebar-content" class="flex-1 overflow-y-auto p-3 space-y-4"></div>
    </aside>

  </div>

  <!-- DOCK FLOTTANT D'ACTIONS RAPIDES EN BAS À DROITE (ICÔNES + TEXTE AU SURVOL) -->
  <div class="no-print fixed bottom-5 right-5 z-40 flex items-center gap-1.5 bg-stone-900/95 text-stone-100 p-1.5 rounded-2xl shadow-2xl border border-white/15 backdrop-blur-md">
    <!-- Mode Focus / Gros plan -->
    <button onclick="app.toggleFocusMode()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-white/15 transition-all duration-200" title="Basculer en mode Gros Plan (masquer les barres latérales)">
      <i data-lucide="maximize-2" class="w-4 h-4 text-amber-400 shrink-0"></i>
      <span id="dock-focus-label" class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Gros plan central</span>
    </button>

    <!-- Taille des onglets -->
    <button onclick="app.toggleCompactTabs()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-white/15 transition-all duration-200" title="Ajuster la largeur des onglets">
      <i data-lucide="columns" class="w-4 h-4 text-sky-400 shrink-0"></i>
      <span id="dock-tab-size-label" class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Onglets compacts / larges</span>
    </button>

    <div class="h-5 w-px bg-white/15 mx-0.5"></div>

    <!-- Export Word .DOC -->
    <button onclick="app.exportActiveToDoc()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-blue-600/80 transition-all duration-200" title="Exporter la fiche active en Word (.doc)">
      <i data-lucide="file-text" class="w-4 h-4 text-blue-300 group-hover:text-white shrink-0"></i>
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Exporter .DOC</span>
    </button>

    <!-- Impression / PDF -->
    <button onclick="window.print()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-purple-600/80 transition-all duration-200" title="Imprimer ou enregistrer en PDF">
      <i data-lucide="printer" class="w-4 h-4 text-purple-300 group-hover:text-white shrink-0"></i>
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">PDF / Imprimer</span>
    </button>

    <div class="h-5 w-px bg-white/15 mx-0.5"></div>

    <!-- Sauvegarde Disque / Drive -->
    <button onclick="app.syncToDiskFile()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-emerald-600/80 transition-all duration-200" title="Synchroniser sur votre ordinateur ou dossier Google Drive (Ctrl+S)">
      <i data-lucide="hard-drive-download" class="w-4 h-4 text-emerald-400 group-hover:text-white shrink-0"></i>
      <span id="disk-file-label" class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Sauvegarder Drive / PC</span>
    </button>

    <!-- Export JSON -->
    <button onclick="app.exportJSON()" class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-white/15 transition-all duration-200" title="Télécharger une sauvegarde complète (.json)">
      <i data-lucide="download" class="w-4 h-4 text-stone-300 shrink-0"></i>
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Exporter .JSON</span>
    </button>

    <!-- Import JSON -->
    <label class="group flex items-center gap-0 hover:gap-2 px-2.5 py-2 rounded-xl hover:bg-white/15 transition-all duration-200 cursor-pointer" title="Importer une sauvegarde (.json)">
      <i data-lucide="upload" class="w-4 h-4 text-stone-300 shrink-0"></i>
      <span class="max-w-0 overflow-hidden group-hover:max-w-xs text-xs font-medium whitespace-nowrap transition-all duration-200">Importer .JSON</span>
      <input type="file" accept=".json" onchange="app.importJSON(event)" class="hidden">
    </label>
  </div>

  <!-- MODALE 1 : GESTIONNAIRE DES TAGS DE DOMINANTES & COULEURS DE SURLIGNAGE -->
  <div id="tags-modal" onclick="app.closeModal('tags-modal')" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4 no-print">
    <div onclick="event.stopPropagation()" class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-stone-200 space-y-5 max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <h3 class="font-serif-title font-bold text-lg text-stone-900 flex items-center gap-2">
            <i data-lucide="tags" class="w-5 h-5 text-amber-700"></i>
            Personnaliser les Dominantes & Couleurs de surlignage
          </h3>
          <p class="text-xs text-stone-500">La couleur choisie surligne automatiquement le titre de la séance dans l'arborescence et sur sa fiche.</p>
        </div>
        <button onclick="app.closeModal('tags-modal')" class="p-1.5 rounded-lg hover:bg-stone-100 text-stone-500"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <!-- Liste des dominantes existantes -->
      <div id="tags-manager-list" class="flex-1 overflow-y-auto space-y-2.5 pr-1"></div>

      <!-- Ajout d'une nouvelle dominante -->
      <div class="pt-3 border-t border-stone-200 bg-stone-50 p-3 rounded-xl space-y-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 block">Ajouter une nouvelle dominante / étiquette</span>
        <div class="flex flex-wrap items-center gap-2">
          <input type="text" id="new-tag-icon" placeholder="Emoji (ex: 🎭)" value="✨" class="w-14 px-2 py-1.5 text-center text-sm bg-white border border-stone-300 rounded-lg">
          <input type="text" id="new-tag-name" placeholder="Nom (ex: Théâtre, Dictée, Projet...)" class="flex-1 px-3 py-1.5 text-xs bg-white border border-stone-300 rounded-lg">
          <input type="color" id="new-tag-color" value="#0284c7" class="w-10 h-8 rounded cursor-pointer border border-stone-300 bg-white p-0.5">
          <button onclick="app.addCustomDominante()" class="px-3 py-1.5 rounded-lg theme-accent-btn text-xs font-semibold">+ Créer le tag</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALE 2 : STUDIO DE MISE EN FORME, THÈMES GRAPHIQUES & AMBIANCE CRÉATIVE -->
  <div id="theme-modal" onclick="app.closeModal('theme-modal')" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4 no-print">
    <div onclick="event.stopPropagation()" class="bg-white rounded-2xl max-w-3xl w-full p-6 shadow-2xl border border-stone-200 space-y-6 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <h3 class="font-serif-title font-bold text-xl text-stone-900 flex items-center gap-2">
            <i data-lucide="palette" class="w-5 h-5 text-amber-700"></i>
            Studio de Mise en forme & Chartes Graphiques
          </h3>
          <p class="text-xs text-stone-500">Personnalisez l'ambiance, les couleurs, les polices, l'organisation et les intitulés de votre site sans toucher au code.</p>
        </div>
        <button onclick="app.closeModal('theme-modal')" class="p-1.5 rounded-lg hover:bg-stone-100 text-stone-500"><i data-lucide="x" class="w-5 h-5"></i></button>
      </div>

      <!-- 1. Thèmes prédéfinis (Chartes graphiques) -->
      <div class="space-y-2.5">
        <label class="text-xs font-bold uppercase tracking-wider text-stone-500 block">1. Choisir une charte graphique (Mood / Ambiance)</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="theme-presets-grid"></div>
      </div>

      <!-- 2. Couleurs sur-mesure -->
      <div class="space-y-2.5 pt-2 border-t border-stone-100">
        <label class="text-xs font-bold uppercase tracking-wider text-stone-500 block">2. Ajuster librement les couleurs du site</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <label class="p-2.5 rounded-xl border border-stone-200 bg-stone-50 flex items-center justify-between cursor-pointer">
            <span class="text-xs font-medium text-stone-700">Fond principal</span>
            <input type="color" id="custom-bg-main" onchange="app.updateCustomColor('bgMain', this.value)" class="w-7 h-7 rounded cursor-pointer border-0">
          </label>
          <label class="p-2.5 rounded-xl border border-stone-200 bg-stone-50 flex items-center justify-between cursor-pointer">
            <span class="text-xs font-medium text-stone-700">Barres latérales</span>
            <input type="color" id="custom-bg-sidebar" onchange="app.updateCustomColor('bgSidebar', this.value)" class="w-7 h-7 rounded cursor-pointer border-0">
          </label>
          <label class="p-2.5 rounded-xl border border-stone-200 bg-stone-50 flex items-center justify-between cursor-pointer">
            <span class="text-xs font-medium text-stone-700">Barre du haut</span>
            <input type="color" id="custom-bg-header" onchange="app.updateCustomColor('bgHeader', this.value)" class="w-7 h-7 rounded cursor-pointer border-0">
          </label>
          <label class="p-2.5 rounded-xl border border-stone-200 bg-stone-50 flex items-center justify-between cursor-pointer">
            <span class="text-xs font-medium text-stone-700">Couleur d'accent</span>
            <input type="color" id="custom-accent" onchange="app.updateCustomColor('accent', this.value)" class="w-7 h-7 rounded cursor-pointer border-0">
          </label>
        </div>
      </div>

