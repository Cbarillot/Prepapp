      // --- SECTION SUPPORTS & MÉDIAS ---
      renderMediaSection(targetType, seqId, seaId, medias) {
        return `
          <div class="theme-card p-5 border shadow-sm space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-stone-600 flex items-center gap-1.5">
                <i data-lucide="image" class="w-4 h-4 text-amber-700"></i>
                Supports Visuels, Diaporamas & Vidéos (En ligne ou Local)
              </h3>
              <div class="no-print flex items-center gap-2">
                <button onclick="app.promptAddMedia('${targetType}', '${seqId}', '${seaId || ''}')"
                        class="px-2.5 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-white text-xs font-medium flex items-center gap-1">
                  <i data-lucide="link" class="w-3.5 h-3.5"></i>
                  <span>+ Lien Web / Chemin</span>
                </button>
                <label class="px-2.5 py-1 rounded-lg theme-accent-btn text-xs font-medium flex items-center gap-1 cursor-pointer">
                  <i data-lucide="folder-up" class="w-3.5 h-3.5"></i>
                  <span>+ Fichier Local (Image/Diapo/Vidéo)</span>
                  <input type="file" onchange="app.handleLocalMediaUpload(event, '${targetType}', '${seqId}', '${seaId || ''}')" class="hidden">
                </label>
              </div>
            </div>

            ${medias.length === 0 ? `
              <p class="text-xs text-stone-400 italic">Aucun média attaché. Ajoutez une illustration, un diaporama, une vidéo ou un PDF.</p>
            ` : `
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                ${medias.map(m => {
                  const isImg = m.type === 'image' || (m.url && (m.url.startsWith('data:image') || /\.(jpg|jpeg|png|gif|webp)$/i.test(m.url)));
                  const iconMap = { image: 'image', slides: 'presentation', video: 'video', doc: 'file-text' };
                  const ic = iconMap[m.type] || 'external-link';
                  return `
                    <div class="group border border-stone-200 rounded-xl p-3 bg-stone-50/70 hover:bg-white hover:shadow-sm transition flex flex-col justify-between gap-2">
                      <div class="space-y-2">
                        ${isImg ? `
                          <div onclick="app.openMediaModal('${this.escapeAttr(m.title)}', '${this.escapeAttr(m.url)}', 'image')"
                               class="h-28 w-full rounded-lg bg-stone-200 overflow-hidden cursor-pointer relative">
                            <img src="${m.url}" alt="${this.escapeAttr(m.title)}" class="w-full h-full object-cover group-hover:scale-105 transition">
                          </div>
                        ` : ''}
                        <div class="flex items-start justify-between gap-2">
                          <div class="flex items-center gap-1.5 min-w-0">
                            <i data-lucide="${ic}" class="w-4 h-4 text-amber-700 shrink-0"></i>
                            <span class="text-xs font-semibold text-stone-800 truncate" title="${this.escapeAttr(m.title)}">${m.title}</span>
                          </div>
                          <button onclick="app.removeMedia('${targetType}', '${seqId}', '${seaId || ''}', '${m.id}')" class="no-print text-stone-400 hover:text-rose-600">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                          </button>
                        </div>
                        ${m.note ? `<p class="text-[11px] text-stone-500">${m.note}</p>` : ''}
                      </div>
                      <div class="pt-1 border-t border-stone-200/60 flex items-center justify-between text-[11px]">
                        <span class="text-stone-400 truncate max-w-[160px]" title="${this.escapeAttr(m.url)}">${m.url.startsWith('data:') ? 'Image locale intégrée' : m.url}</span>
                        ${m.url.startsWith('http') ? `
                          <a href="${m.url}" target="_blank" class="text-amber-800 font-semibold hover:underline flex items-center gap-0.5">Ouvrir <i data-lucide="external-link" class="w-3 h-3"></i></a>
                        ` : `
                          <button onclick="app.openMediaModal('${this.escapeAttr(m.title)}', '${this.escapeAttr(m.url)}', '${m.type}')" class="text-amber-800 font-semibold hover:underline">Aperçu</button>
                        `}
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            `}
          </div>
        `;
      },

      promptAddMedia(targetType, seqId, seaId) {
        const title = prompt("Titre du support (ex: Vidéo BNF, Diaporama Séance 2, Illustration) :");
        if (!title) return;
        const url = prompt("Lien URL (https://...) ou chemin/nom du fichier local :");
        if (!url) return;
        const typeChoice = prompt("Type : 'image', 'slides' (diapo), 'video' ou 'doc' :", "image");
        const note = prompt("Note ou consigne associée (optionnel) :", "");

        this.pushMedia(targetType, seqId, seaId, {
          id: 'med-' + Date.now(),
          type: ['image', 'slides', 'video', 'doc'].includes(typeChoice) ? typeChoice : 'doc',
          title,
          url,
          note
        });
      },

      handleLocalMediaUpload(event, targetType, seqId, seaId) {
        const file = event.target.files[0];
        if (!file) return;
        const isImage = file.type.startsWith('image/');
        const type = isImage ? 'image' : (file.type.includes('video') ? 'video' : (file.name.match(/\.(ppt|pptx|key|odp)$/i) ? 'slides' : 'doc'));

        if (isImage && file.size < 3 * 1024 * 1024) {
          const reader = new FileReader();
          reader.onload = (e) => {
            this.pushMedia(targetType, seqId, seaId, {
              id: 'med-' + Date.now(),
              type: 'image',
              title: file.name,
              url: e.target.result,
              note: "Image locale"
            });
          };
          reader.readAsDataURL(file);
        } else {
          const objectUrl = URL.createObjectURL(file);
          this.pushMedia(targetType, seqId, seaId, {
            id: 'med-' + Date.now(),
            type,
            title: file.name,
            url: objectUrl,
            note: `Fichier local (${Math.round(file.size / 1024)} Ko)`
          });
        }
      },

      pushMedia(targetType, seqId, seaId, mediaObj) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          if (!seq.medias) seq.medias = [];
          seq.medias.push(mediaObj);
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          if (!sea.medias) sea.medias = [];
          sea.medias.push(mediaObj);
        }
        this.saveData();
        this.renderViewport();
      },

      removeMedia(targetType, seqId, seaId, mediaId) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          seq.medias = (seq.medias || []).filter(m => m.id !== mediaId);
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          sea.medias = (sea.medias || []).filter(m => m.id !== mediaId);
        }
        this.saveData();
        this.renderViewport();
      },

      openMediaModal(title, url, type) {
        document.getElementById('modal-media-title').textContent = title;
        const body = document.getElementById('modal-media-body');

        if (type === 'image' || url.startsWith('data:image')) {
          body.innerHTML = `<img src="${url}" class="max-h-[75vh] max-w-full rounded shadow">`;
        } else if (type === 'video' && (url.startsWith('blob:') || url.endsWith('.mp4'))) {
          body.innerHTML = `<video src="${url}" controls class="max-h-[75vh] max-w-full rounded"></video>`;
        } else {
          body.innerHTML = `
            <div class="text-center space-y-3 p-6">
              <p class="text-sm font-semibold text-stone-800">${title}</p>
              <p class="text-xs text-stone-500 break-all">Référence : ${url}</p>
              <a href="${url}" target="_blank" class="inline-block px-4 py-2 rounded theme-accent-btn text-xs font-medium">Ouvrir dans un nouvel onglet</a>
            </div>
          `;
        }
        this.openModal('media-modal');
      },

      // --- 4. VUE CALENDRIER & PROGRAMMATION (AVEC BOUTON DE RETOUR CLAIR) ---
      renderCalendarView(viewport) {
