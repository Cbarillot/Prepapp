      // --- PRÉSERVATION DE LA SÉLECTION ET FORMATAGE RICHE FONCTIONNEL ---
      setupSelectionSaver() {
        const saveSel = () => {
          const sel = window.getSelection();
          if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            const editor = document.getElementById('seance-rich-editor') || document.getElementById('brainstorm-rich-editor');
            if (editor && editor.contains(range.commonAncestorContainer)) {
              this.savedRange = range.cloneRange();
            }
          }
        };
        document.addEventListener('keyup', saveSel);
        document.addEventListener('mouseup', saveSel);
        document.addEventListener('selectionchange', saveSel);
      },

      restoreSelection() {
        const editor = document.getElementById('seance-rich-editor') || document.getElementById('brainstorm-rich-editor');
        if (editor) editor.focus();
        if (this.savedRange) {
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(this.savedRange);
        }
      },

      execFormat(cmd, val = null) {
        this.restoreSelection();
        document.execCommand('styleWithCSS', false, true);
        document.execCommand(cmd, false, val);
        this.syncCurrentEditorContent();
      },

      applyInlineStyle(prop, val) {
        if (!val) return;
        this.restoreSelection();
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) return;
        const range = sel.getRangeAt(0);

        if (range.collapsed) {
          // Si aucun texte n'est surligné, changer la police ou taille globale de l'éditeur
          if (prop === 'fontFamily') this.updateAppearanceField('fontFamily', val);
          if (prop === 'fontSize') this.updateAppearanceField('fontSize', val);
          return;
        }

        const span = document.createElement('span');
        span.style[prop] = val;
        try {
          range.surroundContents(span);
        } catch (e) {
          const fragment = range.extractContents();
          span.appendChild(fragment);
          range.insertNode(span);
        }
        sel.removeAllRanges();
        const newRange = document.createRange();
        newRange.selectNodeContents(span);
        sel.addRange(newRange);
        this.savedRange = newRange.cloneRange();
        this.syncCurrentEditorContent();
      },

