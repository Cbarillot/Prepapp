      },

      updateDominanteColor(name, color) {
        if (!this.data.dominantes[name]) return;
        this.data.dominantes[name].color = color;
        this.saveData();
        this.renderTagsModalList();
        this.renderAll();
      },

      updateDominanteIcon(name, icon) {
        if (!this.data.dominantes[name]) return;
        this.data.dominantes[name].icon = icon;
        this.saveData();
        this.renderAll();
      },

      renameDominante(oldName, newName) {
        const trimmed = (newName || '').trim();
        if (!trimmed || trimmed === oldName) return;
        this.data.dominantes[trimmed] = this.data.dominantes[oldName];
        delete this.data.dominantes[oldName];
        // Mettre à jour les séances et séquences utilisant cet intitulé
        this.data.sequences.forEach(seq => {
          if (seq.competencePrincipale === oldName) seq.competencePrincipale = trimmed;
          seq.seances.forEach(sea => {
            if (sea.dominante === oldName) sea.dominante = trimmed;
          });
        });
        this.saveData();
        this.renderTagsModalList();
        this.renderAll();
      },

      addCustomDominante() {
        const nameEl = document.getElementById('new-tag-name');
        const colorEl = document.getElementById('new-tag-color');
        const iconEl = document.getElementById('new-tag-icon');
        const name = (nameEl.value || '').trim();
        if (!name) return;
        this.data.dominantes[name] = {
          color: colorEl.value || '#0284c7',
          icon: (iconEl.value || '✨').trim()
        };
        nameEl.value = '';
        this.saveData();
        this.renderTagsModalList();
        this.renderAll();
      },

      deleteDominante(name) {
        if (Object.keys(this.data.dominantes).length <= 1) return;
        delete this.data.dominantes[name];
        this.saveData();
        this.renderTagsModalList();
        this.renderAll();
      },

      // --- REDIMENSIONNEMENT & MODE GROS PLAN (FOCUS) ---
      setupResizers() {
        const leftSidebar = document.getElementById('left-sidebar');
        const rightSidebar = document.getElementById('right-sidebar');
        const resizerLeft = document.getElementById('resizer-left');
        const resizerRight = document.getElementById('resizer-right');

        let isResizingLeft = false;
        let isResizingRight = false;

        resizerLeft.addEventListener('mousedown', () => {
          isResizingLeft = true;
          resizerLeft.classList.add('active');
          document.body.style.cursor = 'col-resize';
        });

        resizerRight.addEventListener('mousedown', () => {
          isResizingRight = true;
          resizerRight.classList.add('active');
          document.body.style.cursor = 'col-resize';
        });

        window.addEventListener('mousemove', (e) => {
          if (isResizingLeft) {
            const newWidth = Math.max(190, Math.min(550, e.clientX));
            leftSidebar.style.width = `${newWidth}px`;
            if (!this.showLeft) this.toggleLeftSidebar(true);
          } else if (isResizingRight) {
            const newWidth = Math.max(220, Math.min(600, window.innerWidth - e.clientX));
            rightSidebar.style.width = `${newWidth}px`;
            if (!this.showRight) this.toggleRightSidebar(true);
          }
        });

        window.addEventListener('mouseup', () => {
          if (isResizingLeft || isResizingRight) {
            isResizingLeft = false;
            isResizingRight = false;
            resizerLeft.classList.remove('active');
            resizerRight.classList.remove('active');
            document.body.style.cursor = '';
          }
        });
      },

      toggleLeftSidebar(forceState = null) {
        this.showLeft = forceState !== null ? forceState : !this.showLeft;
        document.getElementById('left-sidebar').style.display = this.showLeft ? 'flex' : 'none';
        document.getElementById('resizer-left').style.display = this.showLeft ? 'block' : 'none';
      },

      toggleRightSidebar(forceState = null) {
        this.showRight = forceState !== null ? forceState : !this.showRight;
        document.getElementById('right-sidebar').style.display = this.showRight ? 'flex' : 'none';
        document.getElementById('resizer-right').style.display = this.showRight ? 'block' : 'none';
      },

      toggleFocusMode() {
        if (this.showLeft || this.showRight) {
          this.toggleLeftSidebar(false);
          this.toggleRightSidebar(false);
        } else {
          this.toggleLeftSidebar(true);
          this.toggleRightSidebar(true);
        }
      },

      toggleCompactTabs() {
        this.data.settings.compactTabs = !this.data.settings.compactTabs;
        this.saveData();
        this.renderTabs();
      },

      // --- ARBORESCENCE GAUCHE AVEC SURLIGNAGE CLAIR SELON LA COULEUR DU TAG ---
      setFilter(filter) {
        this.currentFilter = filter;
        this.renderTree();
      },

      renderDominanteFilters() {
        const container = document.getElementById('dominante-filters');
        if (!container) return;
        const domKeys = Object.keys(this.data.dominantes || {});

        let html = `
          <button onclick="app.setFilter('ALL')"
                  class="text-[10px] px-2 py-0.5 rounded-full font-semibold transition ${this.currentFilter === 'ALL' ? 'bg-stone-900 text-white' : 'bg-white/80 text-stone-700 border border-stone-300 hover:bg-white'}">
            Tout
          </button>
        `;

        domKeys.forEach(k => {
          const st = this.getDominanteStyle(k);
          const isActive = this.currentFilter === k;
          html += `
            <button onclick="app.setFilter('${this.escapeAttr(k)}')"
                    style="background-color: ${isActive ? st.color : st.bgSoft}; color: ${isActive ? '#fff' : '#1c1917'}; border-color: ${st.borderSoft};"
                    class="text-[10px] px-2 py-0.5 rounded-full font-medium border flex items-center gap-1 transition">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: ${isActive ? '#fff' : st.color}"></span>
              <span>${k}</span>
            </button>
          `;
        });

        html += `
          <button onclick="app.openModal('tags-modal')" title="Modifier ou ajouter un tag de dominante"
                  class="text-[10px] px-1.5 py-0.5 rounded-full bg-white border border-stone-300 text-stone-600 hover:text-stone-900">
            + Tag
          </button>
        `;
        container.innerHTML = html;
      },

      renderTree() {
        this.renderDominanteFilters();
        const container = document.getElementById('tree-container');
        const query = (document.getElementById('tree-search')?.value || '').toLowerCase();
        container.innerHTML = '';

        this.data.sequences.forEach(seq => {
          const filteredSeances = seq.seances.filter(sea => {
            const matchFilter = this.currentFilter === 'ALL' || sea.dominante === this.currentFilter;
            const matchQuery = !query || sea.titre.toLowerCase().includes(query) || seq.titre.toLowerCase().includes(query) || (sea.objectifs || '').toLowerCase().includes(query);
            return matchFilter && matchQuery;
          });

          const seqMatches = !query || seq.titre.toLowerCase().includes(query) || filteredSeances.length > 0;
          if (!seqMatches && this.currentFilter !== 'ALL') return;

          const isSeqActive = this.currentMainView === 'workspace' && this.activeTabId === `tab-${seq.id}`;
          const paStyle = this.getDominanteStyle(seq.competencePrincipale);

          const details = document.createElement('details');
          details.open = true;
          details.className = "group theme-card border shadow-2xs overflow-hidden";

          details.innerHTML = `
            <summary class="list-none cursor-pointer px-2.5 py-2 bg-stone-50/90 hover:bg-stone-100/80 flex items-center justify-between border-b border-stone-200/70">
              <div class="flex items-center gap-2 min-w-0 flex-1">
                <i data-lucide="chevron-right" class="w-3.5 h-3.5 text-stone-400 transition-transform group-open:rotate-90 shrink-0"></i>
                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded shrink-0" style="background-color:${paStyle.bgActive}; color:${paStyle.color};">${seq.code || 'PA'}</span>
                <span class="text-xs font-semibold text-stone-800 truncate" title="${this.escapeAttr(seq.titre)}">${seq.titre}</span>
              </div>
              <button onclick="event.stopPropagation(); app.createSeance('${seq.id}')" title="Ajouter une séance dans ce PA" class="p-1 rounded hover:bg-stone-200 text-stone-500 hover:text-stone-900 shrink-0">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              </button>
            </summary>
            <div class="p-1.5 space-y-1">
              <!-- Lien Présentation du PA -->
              <div onclick="app.openTab({ id: 'tab-${seq.id}', type: 'sequence', seqId: '${seq.id}' }, true)"
                   class="cursor-pointer px-2.5 py-1.5 rounded-lg text-xs flex items-center justify-between transition ${isSeqActive ? 'bg-stone-900 text-white font-semibold shadow-2xs' : 'text-stone-600 hover:bg-stone-100'}">
                <div class="flex items-center gap-2 truncate">
                  <i data-lucide="compass" class="w-3.5 h-3.5 ${isSeqActive ? 'text-amber-300' : 'text-amber-700'} shrink-0"></i>
                  <span class="truncate">Présentation du PA (${seq.competencePrincipale || 'Projet'})</span>
                </div>
                <span class="text-[10px] opacity-75 shrink-0">${seq.seances.length} séa.</span>
              </div>

              <!-- Liste des séances avec SURLIGNAGE CLAIR selon la couleur du tag -->
              ${filteredSeances.map(sea => {
                const isSeaActive = this.currentMainView === 'workspace' && this.activeTabId === `tab-${sea.id}`;
                const st = this.getDominanteStyle(sea.dominante);
                const dateBadge = sea.dateDebut ? new Date(sea.dateDebut).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) : '';
                return `
                  <div onclick="app.openTab({ id: 'tab-${sea.id}', type: 'seance', seqId: '${seq.id}', seaId: '${sea.id}' }, true)"
                       style="background-color: ${isSeaActive ? st.bgActive : st.bgSoft}; border-left: 4px solid ${st.color}; ${isSeaActive ? `outline: 2px solid ${st.color};` : ''}"
                       class="cursor-pointer pl-2.5 pr-2 py-1.5 rounded-r-lg text-xs flex items-center justify-between gap-1.5 transition hover:brightness-95">
                    <div class="flex items-center gap-2 min-w-0 flex-1">
                      <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: ${st.color}" title="Dominante : ${sea.dominante}"></span>
                      <span class="${isSeaActive ? 'font-bold text-stone-950' : 'font-medium text-stone-800'} truncate" title="${this.escapeAttr(sea.titre)}">${sea.titre}</span>
                    </div>
                    ${dateBadge ? `<span class="text-[10px] font-medium text-stone-600 shrink-0">${dateBadge}</span>` : ''}
                  </div>
                `;
              }).join('')}
            </div>
          `;
          container.appendChild(details);
        });

        this.updateStats();
        lucide.createIcons();
      },

      // --- SYSTÈME D'ONGLETS (DANS LA VUE PROJETS & SÉANCES) ---
      openTab(tabObj, makeActive = true) {
        const exists = this.openTabs.find(t => t.id === tabObj.id);
        if (!exists) {
          this.openTabs.push(tabObj);
        }
        if (makeActive) {
          this.activeTabId = tabObj.id;
          this.currentMainView = 'workspace';
        }
        this.renderAll();
      },

      closeTab(tabId, event) {
        if (event) event.stopPropagation();
        const idx = this.openTabs.findIndex(t => t.id === tabId);
        if (idx === -1) return;
        this.openTabs.splice(idx, 1);
        if (this.activeTabId === tabId) {
          this.activeTabId = this.openTabs.length ? this.openTabs[Math.max(0, idx - 1)].id : null;
        }
        this.renderAll();
      },

      renderTabs() {
        const bar = document.getElementById('tabs-bar');
        if (!bar) return;
        bar.innerHTML = '';
        const isCompact = this.data.settings?.compactTabs;
        const maxW = isCompact ? 'max-w-[140px]' : 'max-w-[260px]';

        this.openTabs.forEach(tab => {
          const isActive = tab.id === this.activeTabId;
          let title = "Onglet";
          let dotColor = "#b45309";
          let bgTab = isActive ? "#ffffff" : "rgba(255,255,255,0.45)";

          if (tab.type === 'sequence') {
            const seq = this.getSequence(tab.seqId);
            if (!seq) return;
            title = `${seq.code || 'PA'} : ${seq.titre}`;
            dotColor = this.getDominanteStyle(seq.competencePrincipale).color;
          } else if (tab.type === 'seance') {
            const { sea } = this.getSeance(tab.seqId, tab.seaId);
            if (!sea) return;
            title = sea.titre;
            const st = this.getDominanteStyle(sea.dominante);
            dotColor = st.color;
            if (isActive) bgTab = st.bgSoft;
          }

          const btn = document.createElement('div');
          btn.onclick = () => { this.activeTabId = tab.id; this.switchMainView('workspace'); this.renderAll(); };
          btn.style.backgroundColor = bgTab;
          btn.style.borderTop = isActive ? `3px solid ${dotColor}` : '3px solid transparent';
          btn.className = `group cursor-pointer px-3 py-1.5 rounded-t-lg text-xs flex items-center gap-2 border-x border-stone-300/70 transition shrink-0 ${maxW} ${
            isActive ? 'text-stone-950 font-bold shadow-2xs' : 'text-stone-600 hover:bg-white/80'
          }`;

          btn.innerHTML = `
            <span class="w-2 h-2 rounded-full shrink-0" style="background-color:${dotColor}"></span>
            <span class="truncate" title="${this.escapeAttr(title)}">${title}</span>
            <button onclick="app.closeTab('${tab.id}', event)" class="ml-1 p-0.5 rounded hover:bg-black/10 text-stone-400 hover:text-stone-800 shrink-0">
              <i data-lucide="x" class="w-3 h-3"></i>
            </button>
          `;
          bar.appendChild(btn);
        });
      },

      // --- RENDU DE LA ZONE CENTRALE SELON LA VUE CHOISIE ---
      renderViewport() {
        const viewport = document.getElementById('editor-viewport');
        if (!viewport) return;

        // Mettre à jour l'état visuel des 3 boutons de navigation en haut
        ['workspace', 'calendar', 'brainstorm'].forEach(v => {
          const btn = document.getElementById(`nav-btn-${v}`);
          if (!btn) return;
          if (v === this.currentMainView) {
            btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 bg-white text-stone-900 shadow-sm transition";
          } else {
            btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 text-stone-200 hover:bg-white/10 transition";
          }
        });

        const tabsHeader = document.getElementById('workspace-tabs-header');
        if (tabsHeader) {
          tabsHeader.style.display = this.currentMainView === 'workspace' ? 'flex' : 'none';
        }

        if (this.currentMainView === 'calendar') {
          this.renderCalendarView(viewport);
          lucide.createIcons();
          return;
        }

        if (this.currentMainView === 'brainstorm') {
          this.renderBrainstormFullView(viewport);
          lucide.createIcons();
          return;
        }

        // Vue 'workspace' (Projets & Séances)
        const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
        if (!activeTab) {
          viewport.innerHTML = `
            <div class="h-full flex flex-col items-center justify-center text-center text-stone-400 py-20">
              <i data-lucide="book-open" class="w-12 h-12 mb-3 text-stone-300"></i>
