      // --- UTILITAIRES COULEURS (HEX -> RGBA PASTEL POUR SURLIGNAGE CLAIR) ---
      hexToRgba(hex, alpha = 0.16) {
        if (!hex || typeof hex !== 'string') return `rgba(180, 83, 9, ${alpha})`;
        let c = hex.replace('#', '');
        if (c.length === 3) c = c.split('').map(x => x + x).join('');
        const num = parseInt(c, 16);
        if (isNaN(num)) return `rgba(180, 83, 9, ${alpha})`;
        const r = (num >> 16) & 255;
        const g = (num >> 8) & 255;
        const b = num & 255;
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      },

      getDominanteStyle(domName) {
