      // --- IMPORT DE POLICES & BANQUE D'IMAGES ---
      reloadCustomFonts() {
        const styleEl = document.getElementById('custom-fonts-style');
        if (!styleEl) return;
        let css = '';
        (this.data.customFonts || []).forEach(f => {
          if (f.type === 'google') {
            css += `@import url('https://fonts.googleapis.com/css2?family=${encodeURIComponent(f.name)}:wght@400;600;700&display=swap');\n`;
          } else if (f.type === 'file' && f.dataUrl) {
            css += `@font-face { font-family: '${f.name}'; src: url('${f.dataUrl}'); }\n`;
          }
        });
        styleEl.innerHTML = css;
      },

      promptImportGoogleFont() {
        const fontName = prompt("Entrez le nom exact d'une police Google Fonts (ex: Caveat, Crimson Text, Poppins, Cormorant Garamond, Fira Sans) :");
        if (!fontName || !fontName.trim()) return;
        const clean = fontName.trim();
        this.data.customFonts.push({ name: clean, type: 'google' });
        this.reloadCustomFonts();
        this.updateAppearanceField('titleFont', `'${clean}', serif`);
        this.renderFontPreviewLists();
        this.saveData();
      },

      importLocalFontFile(event) {
        const file = event.target.files[0];
        if (!file) return;
        const fontName = file.name.replace(/\.(ttf|otf|woff2|woff)$/i, '');
        const reader = new FileReader();
        reader.onload = (e) => {
          this.data.customFonts.push({ name: fontName, type: 'file', dataUrl: e.target.result });
          this.reloadCustomFonts();
          this.updateAppearanceField('titleFont', `'${fontName}', sans-serif`);
          this.renderFontPreviewLists();
          this.saveData();
        };
        reader.readAsDataURL(file);
      },

