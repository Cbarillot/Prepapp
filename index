                                style="border-color: ${stComp.border};">${seq.competencesTravaillees || ''}</textarea>
                    </div>
                  </details>
                </div>
              `;
            })()}

            <!-- Supports & Médias du PA (Repliable) -->
            ${this.data.settings.showMedias !== false ? this.renderMediaSection('sequence', seq.id, null, seq.medias || []) : ''}

            <!-- Tableau récapitulatif des séances du PA (Repliable) -->
            <details open class="notion-toggle theme-card border shadow-sm overflow-hidden">
              <summary class="cursor-pointer px-6 py-4 bg-stone-50/70 hover:bg-stone-100/70 flex items-center justify-between border-b border-stone-200/60">
                <h2 class="font-serif-title font-bold text-base text-stone-800 flex items-center gap-2">
                  <i data-lucide="chevron-right" class="w-4 h-4 toggle-chevron text-stone-400"></i>
                  <i data-lucide="list-ordered" class="w-4 h-4 text-amber-700"></i>
                  Progression des séances (${seq.seances.length})
                </h2>
                <button onclick="event.stopPropagation(); app.createSeance('${seq.id}')" class="no-print text-xs font-semibold hover:underline flex items-center gap-1" style="color: var(--accent)">
                  <i data-lucide="plus" class="w-3.5 h-3.5"></i> Nouvelle séance
                </button>
              </summary>
              <div class="p-5 overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="bg-stone-100 text-stone-600 border-y border-stone-200">
                      <th class="py-2.5 px-3 font-semibold">Séance & Dominante</th>
