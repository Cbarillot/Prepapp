                  </div>
                  <div class="flex items-center gap-1.5 no-print">
                    <button onclick="app.openCoverPicker('sequence', '${seq.id}')" class="px-2.5 py-1.5 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-medium flex items-center gap-1 transition">
