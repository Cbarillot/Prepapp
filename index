<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atelier Pédagogique 5ème — Projets d'Apprentissage & Séances</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link id="dynamic-google-fonts" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Merriweather:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;600;700&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Quicksand:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style id="custom-fonts-style"></style>
  <style>
    :root {
      --bg-main: #FAF8F5;
      --bg-sidebar: #F3EFEA;
      --bg-card: #FFFFFF;
      --bg-header: #1C1917;
      --text-header: #F5F5F4;
      --text-main: #292524;
      --accent: #B45309;
      --accent-soft: #FEF3C7;
      --border-color: #E7E5E4;
      --editor-font: 'Inter', sans-serif;
      --title-font: 'Lora', serif;
      --editor-size: 15px;
      --card-radius: 12px;
      --content-max-width: 1024px;
      --ui-zoom: 1;
      --bg-pattern: none;
      --bg-pattern-size: 24px 24px;
      --bg-custom-image: none;
      --bg-veil-opacity: 0.88;
    }

    body {
      font-family: var(--editor-font);
      background-color: var(--bg-main);
      color: var(--text-main);
      position: relative;
    }

    /* Calque de fond avec texture ou image voilée par la couleur du thème */
    #site-bg-layer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-color: var(--bg-main);
      background-image: var(--bg-pattern);
      background-size: var(--bg-pattern-size);
    }

    #site-bg-image-layer {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background-image: var(--bg-custom-image);
      background-size: cover;
      background-position: center;
      opacity: calc(1 - var(--bg-veil-opacity));
      mix-blend-mode: multiply;
    }

    #zoom-scalable-area {
      zoom: var(--ui-zoom);
      position: relative;
      z-index: 10;
    }

    /* Motifs et textures de fond (Bullet journal, Quadrillage, Lignes, Grain de papier) */
    .pattern-dots {
      --bg-pattern: radial-gradient(rgba(120, 113, 108, 0.18) 1.25px, transparent 1.25px);
      --bg-pattern-size: 20px 20px;
    }
    .pattern-grid {
      --bg-pattern: linear-gradient(to right, rgba(120, 113, 108, 0.09) 1px, transparent 1px),
                    linear-gradient(to bottom, rgba(120, 113, 108, 0.09) 1px, transparent 1px);
      --bg-pattern-size: 26px 26px;
    }
    .pattern-lines {
      --bg-pattern: repeating-linear-gradient(0deg, transparent, transparent 27px, rgba(120, 113, 108, 0.11) 28px);
      --bg-pattern-size: 100% 28px;
    }
    .pattern-paper {
      --bg-pattern: radial-gradient(rgba(120, 113, 108, 0.07) 1px, transparent 0),
                    radial-gradient(rgba(168, 162, 158, 0.06) 1px, transparent 0),
                    linear-gradient(135deg, rgba(255,255,255,0.25) 0%, rgba(0,0,0,0.02) 100%);
      --bg-pattern-size: 16px 16px, 23px 23px, 100% 100%;
    }
    .pattern-none {
      --bg-pattern: none;
    }

    .font-serif-title {
      font-family: var(--title-font);
    }

    .theme-header {
      background-color: var(--bg-header);
      color: var(--text-header);
    }

    .theme-sidebar {
      background-color: var(--bg-sidebar);
      border-color: var(--border-color);
    }

    .theme-card {
      background-color: var(--bg-card);
      border-color: var(--border-color);
      border-radius: var(--card-radius);
    }

    .theme-accent-btn {
      background-color: var(--accent);
      color: #ffffff;
    }
    .theme-accent-btn:hover {
      filter: brightness(1.08);
    }

    .content-container {
      max-width: var(--content-max-width);
    }

    /* Blocs dépliables façon Notion */
    details.notion-toggle > summary {
      list-style: none;
    }
    details.notion-toggle > summary::-webkit-details-marker {
      display: none;
    }
    details.notion-toggle > summary .toggle-chevron {
      transition: transform 0.18s ease;
    }
    details.notion-toggle[open] > summary .toggle-chevron {
      transform: rotate(90deg);
    }

    /* Zone d'édition riche */
    .rich-editor {
      font-family: var(--editor-font);
      font-size: var(--editor-size);
      line-height: 1.65;
      min-height: 240px;
      outline: none;
    }
    .rich-editor ul { list-style-type: disc; padding-left: 1.5rem; margin: 0.4rem 0; }
    .rich-editor ol { list-style-type: decimal; padding-left: 1.5rem; margin: 0.4rem 0; }
    .rich-editor h3 { font-weight: 700; font-size: 1.15em; margin-top: 0.75rem; margin-bottom: 0.25rem; color: var(--accent); font-family: var(--title-font); }
    .rich-editor blockquote { border-left: 4px solid var(--accent); padding-left: 0.75rem; color: #57534e; font-style: italic; margin: 0.5rem 0; background: var(--accent-soft); padding: 0.6rem 0.85rem; border-radius: 0.35rem; }

    /* Poignées de redimensionnement */
    .resizer {
      width: 5px;
      cursor: col-resize;
      background-color: transparent;
      transition: background-color 0.15s ease;
      z-index: 20;
    }
    .resizer:hover, .resizer.active {
      background-color: var(--accent);
    }

    /* Scrollbars discrètes */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #d6d3d1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #a8a29e; }

    /* Impression / Export PDF avec respect des réglages d'aperçu */
    @media print {
      .no-print { display: none !important; }
      body, html, #app-root, #main-workspace, #editor-viewport {
        height: auto !important;
        overflow: visible !important;
        background: white !important;
        background-image: none !important;
        padding: 0 !important;
      }
      #print-export-area {
        display: block !important;
      }
    }
  </style>
</head>
<body class="h-screen w-screen overflow-hidden flex flex-col select-none" id="app-root">

  <!-- CALQUES DE FOND (MOTIF / TEXTURE PAPIER / IMAGE AVEC VOILE DU THÈME) -->
  <div id="site-bg-layer" class="no-print"></div>
  <div id="site-bg-image-layer" class="no-print"></div>

  <!-- BARRE SUPÉRIEURE GLOBALE ÉPURÉE & NAVIGATION DE VUES -->
  <header class="no-print h-14 theme-header px-3 py-1.5 flex items-center justify-between border-b border-stone-800/30 shrink-0 shadow-xs z-30">
    <!-- Gauche : Repli panneau + Identité personnalisable -->
    <div class="flex items-center gap-2 min-w-0">
      <button onclick="app.toggleLeftSidebar()" title="Afficher/Masquer l'arborescence (Gauche)" class="p-1.5 rounded-lg hover:bg-white/10 transition">
        <i data-lucide="panel-left" class="w-4 h-4"></i>
      </button>

      <div onclick="app.openModal('theme-modal')" class="flex items-center gap-2 cursor-pointer group px-2 py-1 rounded-lg hover:bg-white/10 transition" title="Cliquer pour personnaliser le thème, la banque d'images ou les polices">
        <span id="site-icon-display" class="text-lg leading-none">📚</span>
        <div class="truncate">
          <h1 id="site-title-display" class="font-serif-title font-semibold text-sm md:text-base tracking-wide truncate">Atelier Pédagogique 5ème</h1>
          <p id="site-subtitle-display" class="text-[10px] opacity-75 truncate hidden sm:block">Programmation & Séquences</p>
        </div>
      </div>
    </div>

    <!-- Centre : Commutateur de Vues Clair (Projets & Séances | Calendrier | Notes & Post-its) -->
    <div class="flex items-center gap-1 bg-black/20 p-1 rounded-xl border border-white/10">
      <button onclick="app.switchMainView('workspace')" id="nav-btn-workspace"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="book-open" class="w-3.5 h-3.5"></i>
        <span>Projets & Séances</span>
      </button>
      <button onclick="app.switchMainView('calendar')" id="nav-btn-calendar"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i>
        <span>Calendrier & Tableau</span>
      </button>
      <button onclick="app.switchMainView('brainstorm')" id="nav-btn-brainstorm"
              class="px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
        <i data-lucide="sticky-note" class="w-3.5 h-3.5"></i>
        <span>Notes & Post-its</span>
      </button>
    </div>

    <!-- Droite : Zoom UI + Annuler/Rétablir + Studio Apparence + Export Preview + Panneau droit -->
    <div class="flex items-center gap-1.5">
      <!-- Contrôle de Zoom Global In / Out -->
      <div class="hidden md:flex items-center bg-black/20 rounded-lg p-0.5 border border-white/10 text-xs">
        <button onclick="app.adjustZoom(-0.08)" title="Dézoomer l'interface" class="p-1.5 rounded hover:bg-white/10 transition">
          <i data-lucide="zoom-out" class="w-3.5 h-3.5"></i>
        </button>
        <button onclick="app.resetZoom()" id="zoom-level-label" title="Réinitialiser le zoom à 100%" class="px-1.5 text-[11px] font-mono font-semibold hover:underline">100%</button>
        <button onclick="app.adjustZoom(0.08)" title="Zoomer l'interface" class="p-1.5 rounded hover:bg-white/10 transition">
          <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i>
        </button>
      </div>

      <!-- Boutons Annuler / Rétablir (Undo / Redo) -->
      <div class="flex items-center bg-black/20 rounded-lg p-0.5 border border-white/10">
        <button onclick="app.undo()" id="btn-undo" title="Annuler la dernière modification (Ctrl+Z)" class="p-1.5 rounded hover:bg-white/10 disabled:opacity-30 transition">
          <i data-lucide="undo-2" class="w-3.5 h-3.5"></i>
        </button>
        <button onclick="app.redo()" id="btn-redo" title="Rétablir la modification (Ctrl+Y)" class="p-1.5 rounded hover:bg-white/10 disabled:opacity-30 transition">
          <i data-lucide="redo-2" class="w-3.5 h-3.5"></i>
        </button>
      </div>

      <!-- Bouton Dominantes -->
      <button onclick="app.openModal('tags-modal')" title="Gérer et colorer les tags de dominantes" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-white/10 hover:bg-white/20 flex items-center gap-1.5 transition">
        <i data-lucide="tags" class="w-3.5 h-3.5"></i>
        <span class="hidden xl:inline">Dominantes</span>
      </button>

      <!-- Bouton Studio d'Apparence, Thèmes & Banque Graphique -->
      <button onclick="app.openModal('theme-modal')" title="Thèmes (Notion, Parchemin...), Polices avec aperçu & Banque d'images" class="px-2.5 py-1.5 rounded-lg text-xs font-medium theme-accent-btn flex items-center gap-1.5 shadow-xs transition">
        <i data-lucide="palette" class="w-3.5 h-3.5"></i>
        <span class="hidden lg:inline">Thèmes & Graphisme</span>
      </button>

      <!-- Bouton Aperçu & Export PDF / Word -->
      <button onclick="app.openExportPreviewModal()" title="Aperçu avant impression PDF ou export Word (.doc)" class="px-2.5 py-1.5 rounded-lg text-xs font-medium bg-white/15 hover:bg-white/25 flex items-center gap-1.5 transition">
        <i data-lucide="printer" class="w-3.5 h-3.5"></i>
        <span class="hidden xl:inline">Aperçu Export</span>
      </button>

      <button onclick="app.toggleRightSidebar()" title="Afficher/Masquer le panneau latéral droit (Notes & To-Do List)" class="p-1.5 rounded-lg hover:bg-white/10 transition">
        <i data-lucide="panel-right" class="w-4 h-4"></i>
      </button>
    </div>
  </header>

  <!-- CORPS DE L'APPLICATION DIRECTEMENT SOUS LA BARRE SUPÉRIEURE (SANS BANNIÈRE DE SITE) -->
  <div id="zoom-scalable-area" class="flex-1 flex overflow-hidden select-text">

    <!-- 1. BARRE LATÉRALE GAUCHE : ARBORESCENCE DES PROJETS D'APPRENTISSAGE & SÉANCES COLORÉES -->
    <aside id="left-sidebar" style="width: 320px;" class="no-print theme-sidebar border-r flex flex-col shrink-0 transition-none overflow-hidden">
      <div class="p-3 border-b border-stone-200/80 space-y-2.5">
        <div class="flex items-center justify-between">
          <span id="label-sidebar-pa" onclick="app.promptRenameLabel('sidebarPA', 'Titre de la colonne de gauche :')" class="text-xs font-bold uppercase tracking-wider text-stone-500 cursor-pointer hover:text-stone-800 flex items-center gap-1" title="Cliquer pour renommer cet intitulé">
            <span>Projets d'Apprentissage</span>
            <i data-lucide="edit-3" class="w-3 h-3 opacity-40"></i>
          </span>
          <button onclick="app.createSequence()" class="px-2.5 py-1 rounded-lg theme-accent-btn text-xs font-medium flex items-center gap-1 shadow-sm transition">
            <i data-lucide="folder-plus" class="w-3.5 h-3.5"></i>
            <span>Nouveau PA</span>
          </button>
        </div>

        <!-- Recherche -->
        <div class="relative">
          <input type="text" id="tree-search" oninput="app.renderTree()" placeholder="Rechercher un PA, une séance..." class="w-full pl-7 pr-2 py-1.5 text-xs bg-white border border-stone-300 rounded-lg focus:outline-none focus:border-amber-600">
          <i data-lucide="search" class="w-3.5 h-3.5 text-stone-400 absolute left-2.5 top-2"></i>
        </div>

        <!-- Filtres dynamiques par dominante + bouton d'édition des tags -->
        <div class="flex items-center gap-1 flex-wrap pt-0.5" id="dominante-filters"></div>
      </div>

      <!-- Liste Arborescente avec surlignage pastel des titres de séances -->
      <div id="tree-container" class="flex-1 overflow-y-auto p-2.5 space-y-2.5"></div>

      <!-- Pied de barre gauche -->
      <div class="p-2.5 border-t border-stone-200/80 bg-black/5 flex items-center justify-between text-[11px] text-stone-600">
        <span id="stats-counter">3 PA • 6 séances</span>
        <button onclick="app.resetToGoogleSheetData()" class="underline hover:text-amber-800" title="Recharger les données initiales du Google Sheet">Données Sheet initiales</button>
      </div>
    </aside>

    <!-- POIGNÉE DE REDIMENSIONNEMENT GAUCHE -->
    <div id="resizer-left" class="resizer no-print"></div>

    <!-- 2. ZONE CENTRALE : ONGLETS ÉPURÉS & CONTENU DE LA VUE ACTIVE -->
    <main id="main-workspace" class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <!-- Barre d'onglets ouverts (uniquement visible en vue Projets & Séances, allégée sans les gros boutons d'export) -->
      <div id="workspace-tabs-header" class="no-print bg-black/5 border-b border-stone-300/80 px-3 pt-1.5 flex items-center justify-between gap-2 shrink-0">
        <div id="tabs-bar" class="flex items-center gap-1.5 overflow-x-auto flex-1 py-0.5"></div>
      </div>

      <!-- Contenu dynamique central -->
      <div id="editor-viewport" class="flex-1 overflow-y-auto p-5 md:p-7"></div>
    </main>

    <!-- POIGNÉE DE REDIMENSIONNEMENT DROITE -->
    <div id="resizer-right" class="resizer no-print"></div>

    <!-- 3. BARRE LATÉRALE DROITE : MINI-ONGLET NOTES & POST-ITS + TO-DO LIST PAR SÉANCE / PA -->
    <aside id="right-sidebar" style="width: 345px;" class="no-print theme-sidebar border-l flex flex-col shrink-0 transition-none overflow-hidden">
      <div class="flex border-b border-stone-200/80 bg-black/5 p-1 gap-1">
        <button onclick="app.setRightTab('todo')" id="rtab-todo" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 bg-white text-stone-900 shadow-xs">
          <i data-lucide="check-square" class="w-3.5 h-3.5 text-emerald-600"></i>
          <span>To-Do List</span>
        </button>
        <button onclick="app.setRightTab('brainstorm')" id="rtab-brainstorm" class="flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 text-stone-600 hover:text-stone-900">
          <i data-lucide="sticky-note" class="w-3.5 h-3.5 text-amber-600"></i>
          <span>Notes & Post-its</span>
        </button>
      </div>

      <div id="right-sidebar-content" class="flex-1 overflow-y-auto p-3 space-y-4"></div>
    </aside>

  </div>

  <!-- BULLE COMPACTE EN BAS À DROITE QUI NE SE DÉPLIE QU'AU SURVOL DE LA SOURIS -->
  <div class="no-print fixed bottom-4 right-4 z-40 group flex items-center justify-end">
    <div class="flex items-center gap-1 bg-stone-900/95 text-stone-100 p-1.5 rounded-full shadow-2xl border border-white/15 backdrop-blur-md transition-all duration-300">
      <!-- Bouton compact principal toujours visible -->
      <div class="w-8 h-8 rounded-full bg-amber-600/90 text-white flex items-center justify-center shrink-0 cursor-pointer shadow-inner" title="Outils rapides & Sauvegarde">
        <i data-lucide="sparkles" class="w-4 h-4"></i>
      </div>

      <!-- Zone d'icônes cachée par défaut et révélée uniquement au survol du conteneur -->
      <div class="max-w-0 opacity-0 overflow-hidden group-hover:max-w-[560px] group-hover:opacity-100 group-hover:px-1.5 flex items-center gap-1 transition-all duration-300 ease-out">
        <!-- Mode Focus / Gros plan -->
        <button onclick="app.toggleFocusMode()" class="px-2.5 py-1.5 rounded-full hover:bg-white/15 flex items-center gap-1.5 text-xs whitespace-nowrap transition" title="Basculer en mode Gros Plan (masquer les barres latérales)">
          <i data-lucide="maximize-2" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
          <span>Gros plan</span>
        </button>

        <!-- Taille des onglets -->
        <button onclick="app.toggleCompactTabs()" class="px-2.5 py-1.5 rounded-full hover:bg-white/15 flex items-center gap-1.5 text-xs whitespace-nowrap transition" title="Ajuster la largeur des onglets">
          <i data-lucide="columns" class="w-3.5 h-3.5 text-sky-400 shrink-0"></i>
          <span>Onglets</span>
        </button>

        <div class="h-4 w-px bg-white/20 mx-0.5"></div>

        <!-- Aperçu & Export PDF / Word -->
        <button onclick="app.openExportPreviewModal()" class="px-2.5 py-1.5 rounded-full hover:bg-blue-600/80 flex items-center gap-1.5 text-xs whitespace-nowrap transition" title="Ouvrir l'aperçu d'exportation PDF / Word (.doc)">
          <i data-lucide="file-output" class="w-3.5 h-3.5 text-blue-300 shrink-0"></i>
          <span>Export PDF / Word</span>
        </button>

        <div class="h-4 w-px bg-white/20 mx-0.5"></div>

        <!-- Sauvegarde Disque / Drive -->
        <button onclick="app.syncToDiskFile()" class="px-2.5 py-1.5 rounded-full hover:bg-emerald-600/80 flex items-center gap-1.5 text-xs whitespace-nowrap transition" title="Synchroniser sur votre ordinateur ou dossier Google Drive (Ctrl+S)">
          <i data-lucide="hard-drive-download" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i>
          <span id="disk-file-label">Drive / PC</span>
        </button>

        <!-- Export JSON -->
        <button onclick="app.exportJSON()" class="p-1.5 rounded-full hover:bg-white/15 transition" title="Télécharger une sauvegarde complète (.json)">
          <i data-lucide="download" class="w-3.5 h-3.5 text-stone-300"></i>
        </button>

        <!-- Import JSON -->
        <label class="p-1.5 rounded-full hover:bg-white/15 transition cursor-pointer" title="Importer une sauvegarde (.json)">
          <i data-lucide="upload" class="w-3.5 h-3.5 text-stone-300"></i>
          <input type="file" accept=".json" onchange="app.importJSON(event)" class="hidden">
        </label>
      </div>
    </div>
  </div>

  <!-- MODALE 1 : GESTIONNAIRE DES TAGS DE DOMINANTES & COULEURS DE SURLIGNAGE -->
  <div id="tags-modal" onclick="app.closeModal('tags-modal')" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4 no-print">
    <div onclick="event.stopPropagation()" class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl border border-stone-200 space-y-4 max-h-[88vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <h3 class="font-serif-title font-bold text-lg text-stone-900 flex items-center gap-2">
            <i data-lucide="tags" class="w-5 h-5 text-amber-700"></i>
            Gérer les Dominantes & Couleurs de Surlignage
          </h3>
          <p class="text-xs text-stone-500">La couleur choisie surligne automatiquement les titres des séances correspondantes.</p>
        </div>
        <button onclick="app.closeModal('tags-modal')" class="p-1.5 rounded-lg hover:bg-stone-100 text-stone-500"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>

      <div id="tags-manager-list" class="space-y-2 max-h-64 overflow-y-auto pr-1"></div>

      <div class="pt-3 border-t border-stone-200 space-y-2">
        <label class="text-xs font-bold uppercase tracking-wider text-stone-500 block">Ajouter une nouvelle dominante</label>
        <div class="flex items-center gap-2">
          <input type="text" id="new-tag-icon" value="✨" class="w-11 text-center text-sm border border-stone-300 rounded-lg py-1.5">
          <input type="text" id="new-tag-name" placeholder="Nom (ex: Projet Théâtre, Méthodologie...)" class="flex-1 text-xs border border-stone-300 rounded-lg px-3 py-2">
          <input type="color" id="new-tag-color" value="#0284c7" class="w-9 h-9 rounded cursor-pointer border-0">
          <button onclick="app.addCustomDominante()" class="px-3 py-2 rounded-lg theme-accent-btn text-xs font-semibold">+ Ajouter</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODALE 2 : STUDIO DE MISE EN FORME, THÈMES (DONT NOTION), APERÇU DE POLICES & BANQUE GRAPHIQUE -->
  <div id="theme-modal" onclick="app.closeModal('theme-modal')" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4 no-print">
    <div onclick="event.stopPropagation()" class="bg-white rounded-2xl max-w-4xl w-full p-6 shadow-2xl border border-stone-200 space-y-6 max-h-[92vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <h3 class="font-serif-title font-bold text-xl text-stone-900 flex items-center gap-2">
            <i data-lucide="palette" class="w-5 h-5 text-amber-700"></i>
