              </h3>
              <div class="no-print flex items-center gap-2">
                <button onclick="app.promptAddMedia('${targetType}', '${seqId}', '${seaId || ''}')"
                        class="px-2.5 py-1 rounded-lg bg-stone-800 hover:bg-stone-700 text-white text-xs font-medium flex items-center gap-1">
                  <i data-lucide="link" class="w-3.5 h-3.5"></i>
                  <span>+ Lien Web / Chemin</span>
                </button>
                <label class="px-2.5 py-1 rounded-lg theme-accent-btn text-xs font-medium flex items-center gap-1 cursor-pointer">
                  <i data-lucide="folder-up" class="w-3.5 h-3.5"></i>
                  <span>+ Fichier Local (Image/Diapo/Vidéo)</span>
                  <input type="file" onchange="app.handleLocalMediaUpload(event, '${targetType}', '${seqId}', '${seaId || ''}')" class="hidden">
                </label>
              </div>
            </div>

            ${medias.length === 0 ? `
              <p class="text-xs text-stone-400 italic">Aucun média attaché. Ajoutez une illustration, un diaporama, une vidéo ou un PDF.</p>
            ` : `
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                ${medias.map(m => {
                  const isImg = m.type === 'image' || (m.url && (m.url.startsWith('data:image') || /\.(jpg|jpeg|png|gif|webp)$/i.test(m.url)));
                  const iconMap = { image: 'image', slides: 'presentation', video: 'video', doc: 'file-text' };
                  const ic = iconMap[m.type] || 'external-link';
                  return `
                    <div class="group border border-stone-200 rounded-xl p-3 bg-stone-50/70 hover:bg-white hover:shadow-sm transition flex flex-col justify-between gap-2">
                      <div class="space-y-2">
                        ${isImg ? `
                          <div onclick="app.openMediaModal('${this.escapeAttr(m.title)}', '${this.escapeAttr(m.url)}', 'image')"
                               class="h-28 w-full rounded-lg bg-stone-200 overflow-hidden cursor-pointer relative">
                            <img src="${m.url}" alt="${this.escapeAttr(m.title)}" class="w-full h-full object-cover group-hover:scale-105 transition">
