                  </thead>
                  <tbody class="divide-y divide-stone-200/70">
                    ${seq.seances.map(sea => {
                      const st = this.getDominanteStyle(sea.dominante);
                      return `
                        <tr onclick="app.openTab({ id: 'tab-${sea.id}', type: 'seance', seqId: '${seq.id}', seaId: '${sea.id}' }, true)"
                            style="background-color: ${st.bgSoft};"
                            class="hover:brightness-95 cursor-pointer transition">
                          <td class="py-3 px-3 font-semibold text-stone-900" style="border-left: 4px solid ${st.color}">
                            <div class="flex items-center gap-2">
                              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold text-white" style="background-color: ${st.color}">${sea.icon || st.icon} ${sea.dominante}</span>
                              <span>${sea.titre}</span>
                            </div>
                          </td>
                          <td class="py-3 px-3 text-stone-700 whitespace-nowrap">
