              </div>
              <button onclick="event.stopPropagation(); app.createSeance('${seq.id}')" title="Ajouter une séance dans ce PA" class="p-1 rounded hover:bg-stone-200 text-stone-500 hover:text-stone-900 shrink-0">
                <i data-lucide="plus" class="w-3.5 h-3.5"></i>
              </button>
            </summary>
            <div class="p-1.5 space-y-1">
              <!-- Double entrée du PA : Présentation (édition complète) + Onglet Résumé (fiche synthèse imprimable) -->
              <div class="grid grid-cols-2 gap-1">
                <div onclick="app.openTab({ id: 'tab-${seq.id}', type: 'sequence', seqId: '${seq.id}' }, true)"
                     class="cursor-pointer px-2 py-1.5 rounded-lg text-[11px] flex items-center gap-1.5 transition ${isSeqActive ? 'bg-stone-900 text-white font-semibold shadow-2xs' : 'text-stone-600 hover:bg-stone-100'}"
                     title="Éditer la présentation complète du PA">
                  <i data-lucide="compass" class="w-3.5 h-3.5 ${isSeqActive ? 'text-amber-300' : 'text-amber-700'} shrink-0"></i>
                  <span class="truncate">Projet (${seq.competencePrincipale || 'PA'})</span>
                </div>
                <div onclick="app.openTab({ id: 'tab-summary-${seq.id}', type: 'summary', seqId: '${seq.id}' }, true)"
                     class="cursor-pointer px-2 py-1.5 rounded-lg text-[11px] flex items-center justify-between gap-1 transition ${isSumActive ? 'bg-amber-800 text-white font-semibold shadow-2xs' : 'bg-amber-50/70 text-amber-950 hover:bg-amber-100/80 border border-amber-200/70'}"
                     title="Ouvrir la fiche synthèse Résumé (prête à imprimer)">
                  <div class="flex items-center gap-1.5 truncate">
                    <i data-lucide="file-check-2" class="w-3.5 h-3.5 ${isSumActive ? 'text-amber-200' : 'text-amber-700'} shrink-0"></i>
                    <span class="truncate">Résumé</span>
                  </div>
                  <span class="text-[10px] opacity-75 shrink-0">${seq.seances.length}s</span>
                </div>
              </div>

              <!-- Liste des séances avec SURLIGNAGE CLAIR selon la couleur du tag -->
              ${filteredSeances.map(sea => {
                const isSeaActive = this.currentMainView === 'workspace' && this.activeTabId === `tab-${sea.id}`;
                const st = this.getDominanteStyle(sea.dominante);
                const dateBadge = sea.dateDebut ? new Date(sea.dateDebut).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' }) : '';
                return `
                  <div onclick="app.openTab({ id: 'tab-${sea.id}', type: 'seance', seqId: '${seq.id}', seaId: '${sea.id}' }, true)"
                       style="background-color: ${isSeaActive ? st.bgActive : st.bgSoft}; border-left: 4px solid ${st.color}; ${isSeaActive ? `outline: 2px solid ${st.color};` : ''}"
