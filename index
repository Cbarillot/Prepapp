                <button onclick="app.toggleAllBlocks('sequence', '${seq.id}', null, true)" class="px-2.5 py-1 rounded-lg bg-white/80 hover:bg-white text-[11px] font-medium text-stone-700 flex items-center gap-1" title="Développer toutes les zones">
