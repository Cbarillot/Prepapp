                  <!-- Corpus (Violet par défaut) -->
                  <details open class="notion-toggle theme-card border shadow-xs overflow-hidden" style="border-color: ${stCorp.border};">
                    <summary class="cursor-pointer px-4 py-3 flex items-center justify-between border-b transition hover:brightness-95"
                             style="background-color: ${stCorp.headerBg}; border-color: ${stCorp.border};">
                      <span class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5" style="color: ${stCorp.color};">
                        <i data-lucide="chevron-right" class="w-4 h-4 toggle-chevron"></i>
                        <i data-lucide="library" class="w-4 h-4"></i> Corpus (Textes, Images, Extraits)
