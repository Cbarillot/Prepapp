                    <div class="p-4" style="background-color: ${stObj.bodyBg};">
                      <textarea onchange="app.updateSeqField('${seq.id}', 'objectifGeneral', this.value)" rows="4"
                                class="w-full text-xs leading-relaxed text-stone-800 bg-white/85 p-3 rounded-lg border focus:outline-none"
