                           class="w-full text-xs font-semibold text-stone-800 bg-transparent focus:outline-none">
                  </div>
                  <div class="bg-stone-50/80 p-3 rounded-lg border border-stone-200/80">
                    <label class="block text-[10px] font-bold uppercase text-stone-400 mb-1">Progression & To-Do</label>
                    <div class="text-xs font-semibold text-stone-800">${seq.seances.length} séance(s) • ${(seq.todos || []).filter(t=>t.done).length}/${(seq.todos || []).length} tâches</div>
                  </div>
                </div>

                <!-- Questionnement / Problématique -->
                <div class="p-3.5 rounded-r-lg" style="background-color: var(--accent-soft); border-left: 4px solid var(--accent);">
                  <label class="block text-[10px] font-bold uppercase tracking-wider mb-1" style="color: var(--accent)">Questionnement directeur</label>
                  <input type="text" value="${this.escapeAttr(seq.questionnement || '')}" placeholder="Quelle est la problématique de la séquence ?"
                         onchange="app.updateSeqField('${seq.id}', 'questionnement', this.value)"
                         class="w-full text-sm font-serif-title italic text-stone-800 bg-transparent focus:outline-none">
                </div>
              </div>
            </div>

            <!-- BLOCS DÉPLIABLES / REPLIABLES COLORÉS DU PROJET D'APPRENTISSAGE -->
            ${(() => {
              const stObj = this.getBlockStyle('paObjectif');
              const stEval = this.getBlockStyle('paEvaluation');
              const stCorp = this.getBlockStyle('paCorpus');
              const stComp = this.getBlockStyle('paCompetences');
              return `
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- Objectif général (Rose / Rouge par défaut) -->
                  <details open class="notion-toggle theme-card border shadow-xs overflow-hidden" style="border-color: ${stObj.border};">
                    <summary class="cursor-pointer px-4 py-3 flex items-center justify-between border-b transition hover:brightness-95"
                             style="background-color: ${stObj.headerBg}; border-color: ${stObj.border};">
                      <span class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5" style="color: ${stObj.color};">
                        <i data-lucide="chevron-right" class="w-4 h-4 toggle-chevron"></i>
                        <i data-lucide="target" class="w-4 h-4"></i> Objectif général
                      </span>
                      <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                        <input type="color" value="${stObj.color}" title="Changer la couleur de cet onglet"
                               onchange="app.updateBlockColor('paObjectif', this.value)"
                               class="w-4 h-4 rounded-full border-0 p-0 bg-transparent cursor-pointer">
