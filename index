      // --- HISTORIQUE ANNULER / RÉTABLIR (UNDO / REDO) ---
      pushHistoryState() {
        if (this.isUndoRedoAction) return;
        const snapshot = JSON.stringify({
          sequences: this.data.sequences,
          brainstorming: this.data.brainstorming,
          dominantes: this.data.dominantes,
          settings: this.data.settings
        });
        if (this.historyStack.length > 0 && this.historyStack[this.historyStack.length - 1] === snapshot) return;
        this.historyStack.push(snapshot);
        if (this.historyStack.length > 35) this.historyStack.shift();
        this.redoStack = [];
        this.updateUndoRedoButtons();
      },

      undo() {
        if (this.historyStack.length > 1) {
          this.isUndoRedoAction = true;
          const current = this.historyStack.pop();
          this.redoStack.push(current);
          const prev = JSON.parse(this.historyStack[this.historyStack.length - 1]);
          Object.assign(this.data, prev);
          this.saveData(false);
          this.applyAppearanceToDOM();
          this.renderAll();
          this.updateUndoRedoButtons();
          this.isUndoRedoAction = false;
        } else {
          document.execCommand('undo');
        }
      },

      redo() {
        if (this.redoStack.length > 0) {
          this.isUndoRedoAction = true;
          const nextStr = this.redoStack.pop();
          this.historyStack.push(nextStr);
          const next = JSON.parse(nextStr);
          Object.assign(this.data, next);
          this.saveData(false);
          this.applyAppearanceToDOM();
          this.renderAll();
          this.updateUndoRedoButtons();
          this.isUndoRedoAction = false;
        } else {
          document.execCommand('redo');
        }
      },

