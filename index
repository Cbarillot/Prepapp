      // --- SYSTÈME D'ONGLETS (DANS LA VUE PROJETS & SÉANCES) ---
      openTab(tabObj, makeActive = true) {
        const exists = this.openTabs.find(t => t.id === tabObj.id);
        if (!exists) {
          this.openTabs.push(tabObj);
        }
        if (makeActive) {
          this.activeTabId = tabObj.id;
          this.currentMainView = 'workspace';
        }
        this.renderAll();
      },

      closeTab(tabId, event) {
        if (event) event.stopPropagation();
        const idx = this.openTabs.findIndex(t => t.id === tabId);
        if (idx === -1) return;
        this.openTabs.splice(idx, 1);
        if (this.activeTabId === tabId) {
          this.activeTabId = this.openTabs.length ? this.openTabs[Math.max(0, idx - 1)].id : null;
        }
        this.renderAll();
      },

      renderTabs() {
        const bar = document.getElementById('tabs-bar');
        if (!bar) return;
        bar.innerHTML = '';
        const isCompact = this.data.settings?.compactTabs;
        const maxW = isCompact ? 'max-w-[140px]' : 'max-w-[260px]';

        this.openTabs.forEach(tab => {
          const isActive = tab.id === this.activeTabId;
          let title = "Onglet";
          let dotColor = "#b45309";
          let bgTab = isActive ? "#ffffff" : "rgba(255,255,255,0.45)";
          let iconHtml = "";

          if (tab.type === 'sequence') {
            const seq = this.getSequence(tab.seqId);
            if (!seq) return;
            title = `${seq.icon || '📁'} ${seq.code || 'PA'} : ${seq.titre}`;
            dotColor = this.getDominanteStyle(seq.competencePrincipale).color;
            iconHtml = `<span class="w-2 h-2 rounded-full shrink-0" style="background-color:${dotColor}"></span>`;
          } else if (tab.type === 'summary') {
            const seq = this.getSequence(tab.seqId);
            if (!seq) return;
            title = `Résumé — ${seq.code || 'PA'} : ${seq.titre}`;
            const st = this.getDominanteStyle(seq.competencePrincipale);
            dotColor = st.color;
            if (isActive) bgTab = "#fffbeb";
            iconHtml = `<i data-lucide="file-check-2" class="w-3.5 h-3.5 shrink-0" style="color:${dotColor}"></i>`;
          } else if (tab.type === 'seance') {
            const { sea } = this.getSeance(tab.seqId, tab.seaId);
            if (!sea) return;
            const st = this.getDominanteStyle(sea.dominante);
            title = `${sea.icon || st.icon} ${sea.titre}`;
            dotColor = st.color;
            if (isActive) bgTab = st.bgSoft;
            iconHtml = `<span class="w-2 h-2 rounded-full shrink-0" style="background-color:${dotColor}"></span>`;
          } else if (tab.type === 'brainstorm') {
            title = "💡 Notes & Post-its";
            dotColor = "#d97706";
            if (isActive) bgTab = "#fffbeb";
            iconHtml = `<i data-lucide="sticky-note" class="w-3.5 h-3.5 text-amber-600 shrink-0"></i>`;
          }

          const btn = document.createElement('div');
          btn.onclick = () => { this.activeTabId = tab.id; this.switchMainView('workspace'); this.renderAll(); };
          btn.style.backgroundColor = bgTab;
          btn.style.borderTop = isActive ? `3px solid ${dotColor}` : '3px solid transparent';
          btn.className = `group cursor-pointer px-3 py-1.5 rounded-t-lg text-xs flex items-center gap-2 border-x border-stone-300/70 transition shrink-0 ${maxW} ${
            isActive ? 'text-stone-950 font-bold shadow-2xs' : 'text-stone-600 hover:bg-white/80'
          }`;

          btn.innerHTML = `
            ${iconHtml}
            <span class="truncate" title="${this.escapeAttr(title)}">${title}</span>
            <button onclick="app.closeTab('${tab.id}', event)" class="ml-1 p-0.5 rounded hover:bg-black/10 text-stone-400 hover:text-stone-800 shrink-0">
              <i data-lucide="x" class="w-3 h-3"></i>
            </button>
          `;
          bar.appendChild(btn);
        });
      },

      // --- RENDU DE LA ZONE CENTRALE SELON LA VUE CHOISIE ---
      renderViewport() {
        const viewport = document.getElementById('editor-viewport');
        if (!viewport) return;

        // Mettre à jour l'état visuel des 3 boutons de navigation en haut
        const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
        ['workspace', 'calendar', 'brainstorm'].forEach(v => {
          const btn = document.getElementById(`nav-btn-${v}`);
          if (!btn) return;
          const isCurrent = (v === 'brainstorm' && activeTab && activeTab.type === 'brainstorm' && this.currentMainView === 'workspace') ||
                            (v === this.currentMainView && !(v === 'workspace' && activeTab && activeTab.type === 'brainstorm'));
          if (isCurrent) {
            btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 bg-white text-stone-900 shadow-sm transition";
          } else {
            btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 text-stone-200 hover:bg-white/10 transition";
          }
        });

        const tabsHeader = document.getElementById('workspace-tabs-header');
        if (tabsHeader) {
          tabsHeader.style.display = this.currentMainView === 'workspace' ? 'flex' : 'none';
        }

        if (this.currentMainView === 'calendar') {
          this.renderCalendarView(viewport);
          lucide.createIcons();
          return;
        }

        if (!activeTab) {
          viewport.innerHTML = `
            <div class="h-full flex flex-col items-center justify-center text-center text-stone-400 py-20">
              <i data-lucide="book-open" class="w-12 h-12 mb-3 text-stone-300"></i>
              <p class="font-serif-title text-lg text-stone-600">Sélectionnez un Projet d'Apprentissage, un Résumé ou une Séance à gauche</p>
              <p class="text-xs mt-1">Ou utilisez la barre supérieure pour ouvrir le Calendrier ou l'onglet Notes & Post-its.</p>
            </div>
          `;
          lucide.createIcons();
          return;
        }

        if (activeTab.type === 'brainstorm') {
          this.renderBrainstormFullView(viewport);
        } else if (activeTab.type === 'sequence') {
          this.renderSequenceView(viewport, activeTab.seqId);
        } else if (activeTab.type === 'summary') {
          this.renderSequenceSummaryView(viewport, activeTab.seqId);
        } else if (activeTab.type === 'seance') {
          this.renderSeanceView(viewport, activeTab.seqId, activeTab.seaId);
        }
        lucide.createIcons();
      },

