                      </button>
                    </div>
                  `).join('')}
                </div>

                <div class="flex gap-1.5 pt-1">
                  <input type="text" id="new-pa-todo-input" placeholder="Ajouter une tâche au PA..."
                         onkeydown="if(event.key==='Enter') app.addTodoItem('sequence', '${seq.id}', null, 'new-pa-todo-input')"
                         class="flex-1 text-xs px-2.5 py-1.5 rounded-lg border border-stone-300 bg-white focus:outline-none">
                  <button onclick="app.addTodoItem('sequence', '${seq.id}', null, 'new-pa-todo-input')" class="px-2.5 py-1.5 rounded-lg theme-accent-btn text-xs font-bold">+</button>
                </div>
              </div>
            `;
          }
        }
        lucide.createIcons();
      },

      // --- GESTION CRUD DES TO-DO LISTS PAR SÉANCE & SÉQUENCE ---
      getTargetTodoArray(targetType, seqId, seaId) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          if (!seq.todos) seq.todos = DEFAULT_PA_TODOS();
          return seq.todos;
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          if (!sea.todos) sea.todos = DEFAULT_SEANCE_TODOS();
          return sea.todos;
        }
      },

      toggleTodoItem(targetType, seqId, seaId, todoId, checked) {
        const arr = this.getTargetTodoArray(targetType, seqId, seaId);
        const item = arr.find(t => t.id === todoId);
        if (item) item.done = checked;
        this.saveData();
        this.renderRightSidebar();
      },

      updateTodoText(targetType, seqId, seaId, todoId, newText) {
        const arr = this.getTargetTodoArray(targetType, seqId, seaId);
        const item = arr.find(t => t.id === todoId);
        if (item) item.text = newText;
        this.saveData();
      },

      addTodoItem(targetType, seqId, seaId, inputId) {
        const inp = document.getElementById(inputId);
        if (!inp || !inp.value.trim()) return;
        const arr = this.getTargetTodoArray(targetType, seqId, seaId);
        arr.push({ id: 'td-' + Date.now(), text: inp.value.trim(), done: false });
        inp.value = '';
        this.saveData();
        this.renderRightSidebar();
      },

      deleteTodoItem(targetType, seqId, seaId, todoId) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          seq.todos = (seq.todos || []).filter(t => t.id !== todoId);
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          sea.todos = (sea.todos || []).filter(t => t.id !== todoId);
        }
        this.saveData();
        this.renderRightSidebar();
      },

      // --- MÉTHODES UTILITAIRES DE DONNÉES (PA, SÉANCES, BRAINSTORMING) ---
      getSequence(seqId) {
        return this.data.sequences.find(s => s.id === seqId);
      },

      getSeance(seqId, seaId) {
        const seq = this.getSequence(seqId);
        if (!seq) return { seq: null, sea: null };
        const sea = seq.seances.find(s => s.id === seaId);
        return { seq, sea };
      },

      findSeanceById(seaId) {
        for (const seq of this.data.sequences) {
          const sea = seq.seances.find(s => s.id === seaId);
          if (sea) return { seq, sea };
        }
        return null;
      },

      updateSeqField(seqId, field, value) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        seq[field] = value;
        this.saveData();
        this.renderTree();
        this.renderTabs();
      },

      updateSeaField(seqId, seaId, field, value) {
        const { sea } = this.getSeance(seqId, seaId);
        if (!sea) return;
        sea[field] = value;
        this.saveData();
        this.renderTree();
        this.renderTabs();
      },

      deleteSequence(seqId) {
        this.data.sequences = this.data.sequences.filter(s => s.id !== seqId);
        this.openTabs = this.openTabs.filter(t => t.seqId !== seqId);
        if (this.activeTabId === `tab-${seqId}` || this.activeTabId === `tab-summary-${seqId}`) {
          this.activeTabId = this.openTabs[0]?.id || null;
        }
        this.saveData();
        this.renderAll();
      },

      deleteSeance(seqId, seaId) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        seq.seances = seq.seances.filter(s => s.id !== seaId);
        this.openTabs = this.openTabs.filter(t => t.seaId !== seaId);
        if (this.activeTabId === `tab-${seaId}`) {
          this.activeTabId = `tab-${seqId}`;
        }
        this.saveData();
        this.renderAll();
      },

      addBrainstormCard() {
        if (!this.data.brainstorming.cards) this.data.brainstorming.cards = [];
        const palette = ['#f59e0b', '#10b981', '#3b82f6', '#ec4899', '#8b5cf6'];
        const randomCol = palette[this.data.brainstorming.cards.length % palette.length];
        this.data.brainstorming.cards.unshift({
          id: 'idea-' + Date.now(),
          category: 'Idée',
          color: randomCol,
          title: 'Nouvelle piste pédagogique',
          text: ''
        });
        this.saveData();
        this.renderRightSidebar();
        if (this.activeTabId === 'tab-notes-main') this.renderViewport();
      },

      updateBrainstormCard(id, field, val) {
        const card = this.data.brainstorming.cards.find(c => c.id === id);
        if (card) {
          card[field] = val;
          this.saveData();
          this.renderRightSidebar();
        }
      },

      deleteBrainstormCard(id) {
        this.data.brainstorming.cards = this.data.brainstorming.cards.filter(c => c.id !== id);
        this.saveData();
        this.renderRightSidebar();
        if (this.activeTabId === 'tab-notes-main') this.renderViewport();
      },

      async syncToDiskFile() {
        try {
          if ('showSaveFilePicker' in window) {
            if (!this.fileHandle) {
              this.fileHandle = await window.showSaveFilePicker({
                suggestedName: 'Programmation_5eme_Sauvegarde.json',
                types: [{ description: 'Fichier JSON', accept: { 'application/json': ['.json'] } }]
              });
            }
            const writable = await this.fileHandle.createWritable();
            await writable.write(JSON.stringify(this.data, null, 2));
            await writable.close();
            const lbl = document.getElementById('disk-file-label');
            if (lbl) lbl.textContent = `Synchronisé (${this.fileHandle.name})`;
          } else {
            this.exportJSON();
          }
        } catch (err) {
          if (err.name !== 'AbortError') this.exportJSON();
        }
      },

      exportJSON() {
        const blob = new Blob([JSON.stringify(this.data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Programmation_5eme_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      },

      createSequence() {
        const num = this.data.sequences.length + 1;
        const newSeq = {
          id: 'pa-' + Date.now(),
          code: `PA ${num}`,
          icon: "📚",
          banner: "",
          titre: `Nouveau Projet d'Apprentissage ${num}`,
          entree: "Entrée littéraire...",
          competencePrincipale: "Lecture",
          dureePrevue: "Prévue : 3 semaines",
          questionnement: "",
          objectifGeneral: "",
          corpus: "",
          evaluationSommative: "",
          competencesTravaillees: "",
          todos: DEFAULT_PA_TODOS(),
          medias: [],
          seances: []
        };
        this.data.sequences.push(newSeq);
        this.saveData();
        this.openTab({ id: `tab-${newSeq.id}`, type: 'sequence', seqId: newSeq.id }, true);
      },
      createSeance(seqId) {
        const seq = this.getSequence(seqId);
        if (!seq) return;
        const num = seq.seances.length + 1;
        const newSea = {
          id: 'sea-' + Date.now(),
          numero: `S${num}`,
          icon: "📖",
          banner: "",
          titre: `S${num} - Nouvelle séance`,
          dominante: "Lecture",
          dateDebut: new Date().toISOString().slice(0, 10),
          dateFin: new Date().toISOString().slice(0, 10),
          dureePrevue: "1h",
          dureeReelle: "",
          objectifs: "",
          competences: "",
          miseEnOeuvre: "<h3>1. Mise en activité (10 min)</h3><p>Description...</p><h3>2. Analyse / Activité centrale (35 min)</h3><p>Description...</p><h3>3. Trace écrite (10 min)</h3><p>Synthèse...</p>",
          vigilance: "",
          supports: "",
          devoirs: "",
          notes: "",
          todos: DEFAULT_SEANCE_TODOS(),
          liens: [],
          medias: [],
          checklist: { supportsPrets: false, diapoPret: false, realisee: false }
        };
        seq.seances.push(newSea);
        this.saveData();
        this.openTab({ id: `tab-${newSea.id}`, type: 'seance', seqId: seq.id, seaId: newSea.id }, true);
      },
      // --- STUDIO D'APERÇU AVANT EXPORTATION PDF / WORD (.DOC) AVEC OPTIONS DE MISE EN PAGE ---
      openExportPreviewModal() {
        this.openModal('export-preview-modal');
        this.updateExportPreview();
      },

      buildFormattedExportHTML() {
        const margin = document.getElementById('exp-margin')?.value || '20mm';
        const fontSize = document.getElementById('exp-fontsize')?.value || '11pt';
        const keepColors = document.getElementById('exp-bg-colors')?.checked !== false;
        const showBanner = document.getElementById('exp-show-banner')?.checked !== false;
        const showTodo = document.getElementById('exp-show-todo')?.checked === true;
        const showNotes = document.getElementById('exp-show-notes')?.checked !== false;

        const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
        let docTitle = "Fiche_Pedagogique";
        let innerHtml = "";

        if (this.currentMainView === 'workspace' && activeTab && (activeTab.type === 'sequence' || activeTab.type === 'summary')) {
          const seq = this.getSequence(activeTab.seqId);
          const st = this.getDominanteStyle(seq.competencePrincipale);
          docTitle = `${seq.code}_${seq.titre}`;
          const accentCol = keepColors ? st.color : '#1c1917';
          const softBg = keepColors ? st.bgSoft : '#f5f5f4';

          innerHtml = `
            ${showBanner && seq.banner ? `<div style="height:120px; width:100%; background-image:url('${seq.banner}'); background-size:cover; background-position:center; border-radius:8px; margin-bottom:14px;"></div>` : ''}
            <div style="border-bottom: 3px solid ${accentCol}; padding-bottom: 10px; margin-bottom: 14px;">
              <div style="font-size: 10pt; color: #57534e; font-weight: bold; text-transform: uppercase;">${seq.code} • ${seq.entree || ''} • Dominante : ${seq.competencePrincipale} (${seq.dureePrevue || ''})</div>
              <h1 style="font-family: ${this.data.settings.titleFont}; font-size: 20pt; margin: 4px 0 0 0; color: #1c1917;">${showBanner ? (seq.icon || '') : ''} ${seq.titre}</h1>
            </div>
            <div style="background: ${softBg}; border-left: 4px solid ${accentCol}; padding: 10px 14px; margin-bottom: 16px; font-style: italic;">
              <b>Problématique :</b> ${seq.questionnement || '—'}
            </div>
            <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
              <tr>
                <td style="width:50%; border:1px solid #d6d3d1; padding:10px; vertical-align:top;">
                  <b style="color:${accentCol}; text-transform:uppercase; font-size:9pt;">Objectif général</b><br>
                  ${(seq.objectifGeneral || '').replace(/\n/g, '<br>')}
                </td>
                <td style="width:50%; border:1px solid #d6d3d1; padding:10px; vertical-align:top;">
                  <b style="color:${accentCol}; text-transform:uppercase; font-size:9pt;">Évaluation sommative</b><br>
                  ${(seq.evaluationSommative || '').replace(/\n/g, '<br>')}
                </td>
              </tr>
              <tr>
                <td style="width:50%; border:1px solid #d6d3d1; padding:10px; vertical-align:top;">
                  <b style="color:${accentCol}; text-transform:uppercase; font-size:9pt;">Corpus</b><br>
                  ${(seq.corpus || '').replace(/\n/g, '<br>')}
                </td>
                <td style="width:50%; border:1px solid #d6d3d1; padding:10px; vertical-align:top;">
                  <b style="color:${accentCol}; text-transform:uppercase; font-size:9pt;">Compétences travaillées</b><br>
                  ${(seq.competencesTravaillees || '').replace(/\n/g, '<br>')}
                </td>
              </tr>
            </table>
            <h3 style="font-family: ${this.data.settings.titleFont}; color:${accentCol}; border-bottom:1px solid #e7e5e4; padding-bottom:4px;">Progression ordonnée des séances (${seq.seances.length})</h3>
            <table style="width:100%; border-collapse:collapse; margin-top:8px;">
              <tr style="background:#f5f5f4; font-weight:bold;">
                <td style="border:1px solid #d6d3d1; padding:6px;">#</td>
                <td style="border:1px solid #d6d3d1; padding:6px;">Séance</td>
                <td style="border:1px solid #d6d3d1; padding:6px;">Dominante</td>
                <td style="border:1px solid #d6d3d1; padding:6px;">Dates & Durée</td>
                <td style="border:1px solid #d6d3d1; padding:6px;">Objectif principal</td>
              </tr>
              ${seq.seances.map((s, idx) => {
                const sst = this.getDominanteStyle(s.dominante);
                return `
                  <tr style="background:${keepColors ? sst.bgSoft : 'transparent'};">
                    <td style="border:1px solid #d6d3d1; padding:6px; text-align:center;">${idx + 1}</td>
                    <td style="border:1px solid #d6d3d1; padding:6px; font-weight:bold;">${s.titre}</td>
                    <td style="border:1px solid #d6d3d1; padding:6px;">${s.dominante}</td>
                    <td style="border:1px solid #d6d3d1; padding:6px;">${s.dateDebut || '—'} (${s.dureePrevue || '—'})</td>
                    <td style="border:1px solid #d6d3d1; padding:6px;">${s.objectifs || '—'}</td>
                  </tr>
                `;
              }).join('')}
            </table>
            ${showTodo && seq.todos ? `
              <h3 style="margin-top:16px; font-family:${this.data.settings.titleFont};">To-Do List du Projet</h3>
              <ul>${seq.todos.map(t => `<li>[${t.done ? '✓' : ' '}] ${t.text}</li>`).join('')}</ul>
            ` : ''}
          `;
        } else if (this.currentMainView === 'workspace' && activeTab && activeTab.type === 'seance') {
          const { seq, sea } = this.getSeance(activeTab.seqId, activeTab.seaId);
          const st = this.getDominanteStyle(sea.dominante);
          docTitle = sea.titre;
          const accentCol = keepColors ? st.color : '#1c1917';
          const softBg = keepColors ? st.bgSoft : '#f5f5f4';

          innerHtml = `
            ${showBanner && sea.banner ? `<div style="height:120px; width:100%; background-image:url('${sea.banner}'); background-size:cover; background-position:center; border-radius:8px; margin-bottom:14px;"></div>` : ''}
            <div style="font-size:9.5pt; color:#57534e; font-weight:bold; text-transform:uppercase;">${seq.code} — ${seq.titre}</div>
            <div style="background:${softBg}; border-left:5px solid ${accentCol}; padding:10px 14px; margin:6px 0 14px 0;">
              <h1 style="font-family:${this.data.settings.titleFont}; font-size:18pt; margin:0; color:#1c1917;">${showBanner ? (sea.icon || st.icon) : ''} ${sea.titre}</h1>
              <div style="font-size:9.5pt; margin-top:4px; color:#44403c;">
                <b>Dominante :</b> ${sea.dominante} &nbsp;|&nbsp; <b>Dates :</b> ${sea.dateDebut || '—'} au ${sea.dateFin || '—'} &nbsp;|&nbsp; <b>Durée prévue :</b> ${sea.dureePrevue || '—'} ${sea.dureeReelle ? `(Réelle : ${sea.dureeReelle})` : ''}
              </div>
            </div>

            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
              <tr>
                <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top;">
                  <b style="color:${accentCol}; font-size:9pt; text-transform:uppercase;">Objectifs de la séance</b><br>
                  ${(sea.objectifs || '—').replace(/\n/g, '<br>')}
                </td>
                <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top;">
                  <b style="color:#57534e; font-size:9pt; text-transform:uppercase;">Compétences mobilisées</b><br>
                  ${(sea.competences || '—').replace(/\n/g, '<br>')}
                </td>
              </tr>
            </table>

            <h3 style="font-family:${this.data.settings.titleFont}; color:${accentCol}; border-bottom:1px solid #d6d3d1; padding-bottom:4px;">Mise en œuvre & Déroulement</h3>
            <div style="margin-bottom:16px;">${sea.miseEnOeuvre || ''}</div>

            <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
              <tr>
                <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top;">
                  <b style="font-size:9pt; text-transform:uppercase;">À préparer / Supports</b><br>
                  ${(sea.supports || '—').replace(/\n/g, '<br>')}
                </td>
                <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top;">
                  <b style="font-size:9pt; text-transform:uppercase;">Points de vigilance & Adaptations</b><br>
                  ${(sea.vigilance || '—').replace(/\n/g, '<br>')}
                </td>
              </tr>
              <tr>
                <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top;" colspan="${showNotes ? '1' : '2'}">
                  <b style="font-size:9pt; text-transform:uppercase;">Devoirs / Prolongement</b><br>
                  ${(sea.devoirs || '—').replace(/\n/g, '<br>')}
                </td>
                ${showNotes ? `
                  <td style="width:50%; border:1px solid #d6d3d1; padding:8px; vertical-align:top; background:${keepColors ? '#fffbeb' : 'transparent'};">
                    <b style="font-size:9pt; text-transform:uppercase;">Notes & Bilan (5A / 5C)</b><br>
                    ${(sea.notes || '—').replace(/\n/g, '<br>')}
                  </td>
                ` : ''}
              </tr>
            </table>

            ${showTodo && sea.todos ? `
              <h3 style="font-family:${this.data.settings.titleFont}; font-size:11pt;">To-Do List de préparation</h3>
              <ul>${sea.todos.map(t => `<li>[${t.done ? '✓' : ' '}] ${t.text}</li>`).join('')}</ul>
            ` : ''}
          `;
        } else {
          innerHtml = document.getElementById('editor-viewport').innerHTML;
        }

        return {
          docTitle,
          margin,
          fontSize,
          html: `<div style="padding:${margin}; font-family:${this.data.settings.fontFamily}; font-size:${fontSize}; line-height:1.55; color:#1c1917;">${innerHtml}</div>`
        };
      },

      updateExportPreview() {
        const sheet = document.getElementById('export-preview-sheet');
        if (!sheet) return;
        const { html } = this.buildFormattedExportHTML();
        sheet.innerHTML = html;
      },

      triggerFormattedDocExport() {
        const { docTitle, html } = this.buildFormattedExportHTML();
        const fullWordDoc = `
          <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
          <head><meta charset='utf-8'><title>${docTitle}</title></head>
          <body>${html}</body></html>
        `;
        const blob = new Blob(['\ufeff', fullWordDoc], { type: 'application/msword' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${docTitle.replace(/[^a-z0-9àâçéèêëîïôûùüÿñæœ_-]/gi, '_')}.doc`;
        a.click();
        URL.revokeObjectURL(url);
      },

      triggerFormattedPrint() {
        const { docTitle, html } = this.buildFormattedExportHTML();
        const printWin = window.open('', '_blank', 'width=900,height=700');
        if (!printWin) {
          window.print();
          return;
        }
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
          <head>
            <meta charset="utf-8">
            <title>${docTitle}</title>
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Lora:ital,wght@0,400;0,700;1,400&family=Merriweather:wght@400;700&family=Montserrat:wght@400;700&family=Playfair+Display:wght@500;700&family=Quicksand:wght@400;700&display=swap" rel="stylesheet">
            <style>
              @page { margin: 0; }
              body { margin: 0; background: white; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            </style>
          </head>
          <body>${html}</body>
          </html>
        `);
        printWin.document.close();
        setTimeout(() => {
          printWin.focus();
          printWin.print();
        }, 350);
      },

      exportActiveToDoc() {
        this.openExportPreviewModal();
      },

      importJSON(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          try {
            const parsed = JSON.parse(e.target.result);
            if (parsed && parsed.sequences) {
              this.data = parsed;
              if (!this.data.dominantes) this.data.dominantes = JSON.parse(JSON.stringify(DEFAULT_DOMINANTES));
              this.saveData();
              this.applyAppearanceToDOM();
              this.renderAll();
            }
          } catch (err) {
            console.error("Fichier JSON invalide", err);
          }
        };
        reader.readAsText(file);
      },

      resetToGoogleSheetData() {
        this.data = JSON.parse(JSON.stringify(INITIAL_DATA));
        this.saveData();
        this.applyAppearanceToDOM();
        this.openTabs = [];
        this.openTab({ id: 'tab-pa-2', type: 'sequence', seqId: 'pa-2' }, false);
        this.openTab({ id: 'tab-summary-pa-2', type: 'summary', seqId: 'pa-2' }, false);
        this.openTab({ id: 'tab-sea-c2-1', type: 'seance', seqId: 'pa-2', seaId: 'sea-c2-1' }, true);
        this.renderAll();
      },

      setupKeyboardShortcuts() {
        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
            e.preventDefault();
            this.saveData();
            if (this.fileHandle) this.syncToDiskFile();
          } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z' && !e.shiftKey) {
            // Laisser le navigateur gérer l'undo natif si on est dans un champ texte, sinon undo applicatif
            const activeEl = document.activeElement;
            if (!activeEl || (!activeEl.isContentEditable && activeEl.tagName !== 'INPUT' && activeEl.tagName !== 'TEXTAREA')) {
              e.preventDefault();
              this.undo();
            }
          } else if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) {
            const activeEl = document.activeElement;
            if (!activeEl || (!activeEl.isContentEditable && activeEl.tagName !== 'INPUT' && activeEl.tagName !== 'TEXTAREA')) {
              e.preventDefault();
              this.redo();
            }
          }
        });
      },

      formatDateShort(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        return d.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
      },

      escapeAttr(str) {
        return String(str || '').replace(/"/g, '&quot;');
      },

      renderAll() {
        this.renderTree();
        this.renderTabs();
        this.renderViewport();
        this.renderRightSidebar();
        this.updateUndoRedoButtons();
      }
    };

    window.addEventListener('DOMContentLoaded', () => app.init());
  </script>
</body>
</html>
