                      <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                        <input type="color" value="${stCorp.color}" title="Changer la couleur de cet onglet"
                               onchange="app.updateBlockColor('paCorpus', this.value)"
                               class="w-4 h-4 rounded-full border-0 p-0 bg-transparent cursor-pointer">
                        <span class="text-[10px] opacity-70" style="color: ${stCorp.color}">Réduire/déplier</span>
                      </div>
                    </summary>
                    <div class="p-4" style="background-color: ${stCorp.bodyBg};">
                      <textarea onchange="app.updateSeqField('${seq.id}', 'corpus', this.value)" rows="6"
                                class="w-full text-xs leading-relaxed text-stone-800 bg-white/85 p-3 rounded-lg border focus:outline-none"
                                style="border-color: ${stCorp.border};">${seq.corpus || ''}</textarea>
                    </div>
                  </details>

                  <!-- Compétences travaillées (Vert par défaut) -->
                  <details open class="notion-toggle theme-card border shadow-xs overflow-hidden" style="border-color: ${stComp.border};">
                    <summary class="cursor-pointer px-4 py-3 flex items-center justify-between border-b transition hover:brightness-95"
                             style="background-color: ${stComp.headerBg}; border-color: ${stComp.border};">
                      <span class="text-xs font-bold uppercase tracking-wider flex items-center gap-1.5" style="color: ${stComp.color};">
                        <i data-lucide="chevron-right" class="w-4 h-4 toggle-chevron"></i>
                        <i data-lucide="check-square" class="w-4 h-4"></i> Compétences travaillées
                      </span>
                      <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                        <input type="color" value="${stComp.color}" title="Changer la couleur de cet onglet"
                               onchange="app.updateBlockColor('paCompetences', this.value)"
                               class="w-4 h-4 rounded-full border-0 p-0 bg-transparent cursor-pointer">
                        <span class="text-[10px] opacity-70" style="color: ${stComp.color}">Réduire/déplier</span>
