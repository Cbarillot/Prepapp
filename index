        `;
      },

      promptAddMedia(targetType, seqId, seaId) {
        const title = prompt("Titre du support (ex: Vidéo BNF, Diaporama Séance 2, Illustration) :");
        if (!title) return;
        const url = prompt("Lien URL (https://...) ou chemin/nom du fichier local :");
        if (!url) return;
        const typeChoice = prompt("Type : 'image', 'slides' (diapo), 'video' ou 'doc' :", "image");
        const note = prompt("Note ou consigne associée (optionnel) :", "");

        this.pushMedia(targetType, seqId, seaId, {
          id: 'med-' + Date.now(),
          type: ['image', 'slides', 'video', 'doc'].includes(typeChoice) ? typeChoice : 'doc',
          title,
          url,
          note
        });
      },

      handleLocalMediaUpload(event, targetType, seqId, seaId) {
        const file = event.target.files[0];
        if (!file) return;
        const isImage = file.type.startsWith('image/');
        const type = isImage ? 'image' : (file.type.includes('video') ? 'video' : (file.name.match(/\.(ppt|pptx|key|odp)$/i) ? 'slides' : 'doc'));

        if (isImage && file.size < 3 * 1024 * 1024) {
          const reader = new FileReader();
          reader.onload = (e) => {
            this.pushMedia(targetType, seqId, seaId, {
              id: 'med-' + Date.now(),
              type: 'image',
              title: file.name,
              url: e.target.result,
              note: "Image locale"
            });
          };
          reader.readAsDataURL(file);
        } else {
          const objectUrl = URL.createObjectURL(file);
          this.pushMedia(targetType, seqId, seaId, {
            id: 'med-' + Date.now(),
            type,
            title: file.name,
            url: objectUrl,
            note: `Fichier local (${Math.round(file.size / 1024)} Ko)`
          });
        }
      },

      pushMedia(targetType, seqId, seaId, mediaObj) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          if (!seq.medias) seq.medias = [];
          seq.medias.push(mediaObj);
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          if (!sea.medias) sea.medias = [];
          sea.medias.push(mediaObj);
        }
        this.saveData();
        this.renderViewport();
      },

      removeMedia(targetType, seqId, seaId, mediaId) {
        if (targetType === 'sequence') {
          const seq = this.getSequence(seqId);
          seq.medias = (seq.medias || []).filter(m => m.id !== mediaId);
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          sea.medias = (sea.medias || []).filter(m => m.id !== mediaId);
        }
        this.saveData();
        this.renderViewport();
      },

      openMediaModal(title, url, type) {
        document.getElementById('modal-media-title').textContent = title;
        const body = document.getElementById('modal-media-body');

        if (type === 'image' || url.startsWith('data:image')) {
          body.innerHTML = `<img src="${url}" class="max-h-[75vh] max-w-full rounded shadow">`;
        } else if (type === 'video' && (url.startsWith('blob:') || url.endsWith('.mp4'))) {
          body.innerHTML = `<video src="${url}" controls class="max-h-[75vh] max-w-full rounded"></video>`;
        } else {
          body.innerHTML = `
            <div class="text-center space-y-3 p-6">
              <p class="text-sm font-semibold text-stone-800">${title}</p>
              <p class="text-xs text-stone-500 break-all">Référence : ${url}</p>
              <a href="${url}" target="_blank" class="inline-block px-4 py-2 rounded theme-accent-btn text-xs font-medium">Ouvrir dans un nouvel onglet</a>
            </div>
          `;
        }
        this.openModal('media-modal');
      },

      // --- 4. VUE CALENDRIER & PROGRAMMATION (AVEC BOUTON DE RETOUR CLAIR) ---
      renderCalendarView(viewport) {
        const monthStr = this.data.settings.calendarMonth || "2026-10";
        const [year, month] = monthStr.split('-').map(Number);
        const firstDay = new Date(year, month - 1, 1);
        const daysInMonth = new Date(year, month, 0).getDate();
        const startOffset = (firstDay.getDay() + 6) % 7;
        const monthLabel = firstDay.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });

        const allSeances = [];
        this.data.sequences.forEach(seq => {
          seq.seances.forEach(sea => {
            allSeances.push({ seq, sea });
          });
        });

        let cellsHtml = '';
        for (let i = 0; i < startOffset; i++) {
          cellsHtml += `<div class="bg-stone-100/50 border border-stone-200/70 min-h-[105px] p-1.5"></div>`;
        }

        for (let day = 1; day <= daysInMonth; day++) {
          const dateIso = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          const daySeances = allSeances.filter(({ sea }) => {
            if (!sea.dateDebut) return false;
            const end = sea.dateFin || sea.dateDebut;
            return dateIso >= sea.dateDebut && dateIso <= end;
          });

          cellsHtml += `
            <div class="bg-white border border-stone-200 min-h-[105px] p-1.5 flex flex-col justify-between hover:border-amber-400 transition">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-stone-600">${day}</span>
              </div>
              <div class="space-y-1 my-1 flex-1">
                ${daySeances.map(({ seq, sea }) => {
                  const st = this.getDominanteStyle(sea.dominante);
                  return `
                    <div onclick="app.openTab({ id: 'tab-${sea.id}', type: 'seance', seqId: '${seq.id}', seaId: '${sea.id}' }, true)"
                         style="background-color: ${st.bgActive}; border-left: 3px solid ${st.color}; color: #1c1917;"
                         class="cursor-pointer px-1.5 py-1 rounded text-[10px] font-semibold truncate hover:brightness-95"
                         title="${seq.code} • ${sea.titre} (${sea.dureePrevue || ''})">
                      ${st.icon} ${sea.titre}
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        }

        viewport.innerHTML = `
          <div class="content-container mx-auto space-y-6 pb-20">
            <!-- En-tête du Calendrier avec bouton Retour immédiat -->
            <div class="theme-card p-5 border shadow-sm flex flex-wrap items-center justify-between gap-4">
              <div>
                <h2 class="font-serif-title text-xl font-bold text-stone-900 flex items-center gap-2">
                  <i data-lucide="calendar-days" class="w-5 h-5" style="color: var(--accent)"></i>
                  Calendrier & Tableau de Programmation
                </h2>
                <p class="text-xs text-stone-500">Cliquez sur une séance pour l'ouvrir, ou revenez à votre fiche en cours grâce au bouton à droite.</p>
              </div>
              <div class="flex items-center gap-2">
                <button onclick="app.shiftCalendarMonth(-1)" class="p-1.5 rounded-lg border border-stone-300 hover:bg-stone-100"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                <input type="month" value="${monthStr}" onchange="app.setCalendarMonth(this.value)" class="text-xs font-bold uppercase px-3 py-1.5 border border-stone-300 rounded-lg bg-stone-50">
                <button onclick="app.shiftCalendarMonth(1)" class="p-1.5 rounded-lg border border-stone-300 hover:bg-stone-100"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
                <button onclick="app.switchMainView('workspace')" class="ml-2 px-3 py-1.5 rounded-lg theme-accent-btn text-xs font-semibold flex items-center gap-1.5 shadow-sm">
                  <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                  <span>Retour aux Projets & Séances</span>
                </button>
              </div>
            </div>

            <!-- Grille mensuelle -->
            <div class="theme-card p-4 border shadow-sm">
              <div class="text-center font-serif-title font-bold text-base capitalize mb-3" style="color: var(--accent)">${monthLabel}</div>
              <div class="grid grid-cols-7 text-center text-[11px] font-bold uppercase text-stone-500 pb-2">
                <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
              </div>
              <div class="grid grid-cols-7">
                ${cellsHtml}
              </div>
            </div>

            <!-- Vue Tableau complet (fidèle au Google Sheet) -->
            <div class="theme-card p-5 border shadow-sm space-y-3">
              <h3 class="font-serif-title font-bold text-base text-stone-800">Vue Tableau Récapitulatif (Style Google Sheet)</h3>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr class="bg-stone-100 text-stone-600 border-y border-stone-200">
                      <th class="py-2 px-2.5">PA</th>
                      <th class="py-2 px-2.5">Titre de la séance</th>
                      <th class="py-2 px-2.5">Date début</th>
                      <th class="py-2 px-2.5">Date fin</th>
                      <th class="py-2 px-2.5">Prévue / Réelle</th>
                      <th class="py-2 px-2.5">Objectifs</th>
                      <th class="py-2 px-2.5">À préparer / Supports</th>
                      <th class="py-2 px-2.5">Devoirs</th>
                      <th class="py-2 px-2.5">Notes (5A/5C)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-stone-200">
                    ${allSeances.map(({ seq, sea }) => {
                      const st = this.getDominanteStyle(sea.dominante);
                      return `
                        <tr style="background-color: ${st.bgSoft};" class="hover:brightness-95 transition">
                          <td class="py-2.5 px-2.5 font-bold whitespace-nowrap" style="border-left: 4px solid ${st.color}; color: ${st.color}">${seq.code}</td>
                          <td class="py-2.5 px-2.5 font-semibold text-stone-900">
                            <button onclick="app.openTab({ id: 'tab-${sea.id}', type: 'seance', seqId: '${seq.id}', seaId: '${sea.id}' }, true)" class="hover:underline text-left flex items-center gap-1.5">
                              <span>${st.icon}</span>
                              <span>${sea.titre}</span>
                            </button>
                          </td>
                          <td class="py-2.5 px-2.5">
                            <input type="date" value="${sea.dateDebut || ''}" onchange="app.updateSeaField('${seq.id}', '${sea.id}', 'dateDebut', this.value); app.renderViewport();" class="bg-white/80 border border-stone-300 rounded px-1 py-0.5 text-[11px]">
                          </td>
                          <td class="py-2.5 px-2.5">
                            <input type="date" value="${sea.dateFin || ''}" onchange="app.updateSeaField('${seq.id}', '${sea.id}', 'dateFin', this.value); app.renderViewport();" class="bg-white/80 border border-stone-300 rounded px-1 py-0.5 text-[11px]">
                          </td>
                          <td class="py-2.5 px-2.5 whitespace-nowrap">${sea.dureePrevue || '—'} / <span class="font-semibold">${sea.dureeReelle || '—'}</span></td>
                          <td class="py-2.5 px-2.5 max-w-[200px] truncate" title="${this.escapeAttr(sea.objectifs)}">${sea.objectifs || '—'}</td>
                          <td class="py-2.5 px-2.5 max-w-[180px] truncate" title="${this.escapeAttr(sea.supports)}">${sea.supports || '—'}</td>
                          <td class="py-2.5 px-2.5 max-w-[180px] truncate" title="${this.escapeAttr(sea.devoirs)}">${sea.devoirs || '—'}</td>
                          <td class="py-2.5 px-2.5 max-w-[200px] truncate text-stone-600" title="${this.escapeAttr(sea.notes)}">${sea.notes || '—'}</td>
                        </tr>
                      `;
                    }).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;
      },

      setCalendarMonth(val) {
        this.data.settings.calendarMonth = val;
        this.saveData();
        this.renderViewport();
      },

      shiftCalendarMonth(delta) {
        const [y, m] = (this.data.settings.calendarMonth || "2026-10").split('-').map(Number);
        const d = new Date(y, m - 1 + delta, 1);
        this.data.settings.calendarMonth = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
        this.saveData();
        this.renderViewport();
      },

      // --- PANNEAU LATÉRAL DROIT : TO-DO LIST PAR SÉANCE / PA + MINI-ONGLET NOTES & POST-ITS ---
      setRightTab(tab) {
        this.rightTab = tab;
        const tBtn = document.getElementById('rtab-todo');
        const bBtn = document.getElementById('rtab-brainstorm');
        if (tab === 'todo') {
          tBtn.className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 bg-white text-stone-900 shadow-xs";
          bBtn.className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 text-stone-600 hover:text-stone-900";
        } else {
          bBtn.className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 bg-white text-stone-900 shadow-xs";
          tBtn.className = "flex-1 py-1.5 px-2 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 text-stone-600 hover:text-stone-900";
        }
        this.renderRightSidebar();
      },

      renderRightSidebar() {
        const container = document.getElementById('right-sidebar-content');
        if (!container) return;

        if (this.rightTab === 'brainstorm') {
          const cards = this.data.brainstorming?.cards || [];
          container.innerHTML = `
            <div class="theme-card p-3 border shadow-2xs space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-stone-600 flex items-center gap-1">
                  <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-600"></i> Carnet de notes rapide
                </span>
                <button onclick="app.switchMainView('brainstorm')" class="text-[10px] font-semibold px-2 py-0.5 rounded bg-amber-100 text-amber-900 hover:bg-amber-200 transition">Ouvrir en grand onglet</button>
              </div>
              <div contenteditable="true"
                   oninput="app.data.brainstorming.scratchpad = this.innerHTML; app.saveData();"
                   class="text-xs leading-relaxed text-stone-700 bg-amber-50/40 p-2.5 rounded-lg border border-amber-200/70 min-h-[130px] focus:outline-none">${this.data.brainstorming?.scratchpad || ''}</div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500">Post-its (${cards.length})</span>
                <button onclick="app.addBrainstormCard()" class="px-2 py-1 rounded-lg theme-accent-btn text-[11px] font-medium flex items-center gap-1">
                  <i data-lucide="plus" class="w-3 h-3"></i> + Post-it
                </button>
              </div>
              <div class="space-y-2.5">
                ${cards.map(c => {
                  const col = c.color || '#f59e0b';
                  return `
                    <div class="theme-card p-3 border shadow-2xs space-y-1.5" style="border-left: 4px solid ${col}">
                      <div class="flex items-center justify-between gap-1">
                        <input type="text" value="${this.escapeAttr(c.category)}"
                               onchange="app.updateBrainstormCard('${c.id}', 'category', this.value)"
                               style="background-color: ${this.hexToRgba(col, 0.2)}; color: #1c1917;"
                               class="text-[10px] font-bold uppercase px-1.5 py-0.5 rounded w-28">
                        <div class="flex items-center gap-1">
                          <input type="color" value="${col}" onchange="app.updateBrainstormCard('${c.id}', 'color', this.value); app.renderRightSidebar();" class="w-4 h-4 border-0 p-0 bg-transparent cursor-pointer">
                          <button onclick="app.deleteBrainstormCard('${c.id}')" class="text-stone-400 hover:text-rose-600">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                          </button>
                        </div>
                      </div>
                      <input type="text" value="${this.escapeAttr(c.title)}"
                             onchange="app.updateBrainstormCard('${c.id}', 'title', this.value)"
                             placeholder="Titre de l'idée..."
                             class="w-full text-xs font-bold text-stone-800 bg-transparent focus:outline-none">
                      <textarea onchange="app.updateBrainstormCard('${c.id}', 'text', this.value)" rows="2"
                                placeholder="Détails de l'idée..."
                                class="w-full text-xs text-stone-600 bg-stone-50 p-1.5 rounded border border-stone-200/70 focus:outline-none">${c.text || ''}</textarea>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        } else {
          // ONGLET TO-DO LIST PAR SÉANCE ET PAR SÉQUENCE (PRÉREMPLIE MAIS 100% MODIFIABLE)
          const activeTab = this.openTabs.find(t => t.id === this.activeTabId);
          if (!activeTab || (activeTab.type !== 'seance' && activeTab.type !== 'sequence' && activeTab.type !== 'summary')) {
            container.innerHTML = `
              <div class="p-4 text-center text-xs text-stone-500 theme-card border">
                Sélectionnez un <b>Projet d'Apprentissage</b> ou une <b>Séance</b> pour afficher et gérer sa To-Do List dédiée.
              </div>
            `;
          } else {
            const seq = this.getSequence(activeTab.seqId);
            if (!seq) return;
            if (!seq.todos) seq.todos = DEFAULT_PA_TODOS();

            let seaSectionHtml = '';
            if (activeTab.type === 'seance') {
              const { sea } = this.getSeance(activeTab.seqId, activeTab.seaId);
              if (sea) {
                if (!sea.todos) sea.todos = DEFAULT_SEANCE_TODOS();
                const doneCount = sea.todos.filter(t => t.done).length;
                const pct = sea.todos.length ? Math.round((doneCount / sea.todos.length) * 100) : 0;
                seaSectionHtml = `
                  <div class="theme-card p-3.5 border shadow-2xs space-y-3">
                    <div class="flex items-center justify-between">
                      <div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 block">To-Do List de la Séance</span>
                        <h4 class="text-xs font-bold text-stone-900 truncate max-w-[210px]" title="${this.escapeAttr(sea.titre)}">${sea.titre}</h4>
                      </div>
                      <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-900">${doneCount}/${sea.todos.length}</span>
                    </div>

                    <!-- Barre de progression -->
                    <div class="w-full h-1.5 bg-stone-200 rounded-full overflow-hidden">
                      <div class="h-full bg-emerald-600 transition-all" style="width: ${pct}%"></div>
                    </div>

                    <!-- Liste des tâches modifiables -->
                    <div class="space-y-1.5">
                      ${sea.todos.map(t => `
                        <div class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-stone-50 border border-transparent hover:border-stone-200 group">
                          <input type="checkbox" ${t.done ? 'checked' : ''}
                                 onchange="app.toggleTodoItem('seance', '${seq.id}', '${sea.id}', '${t.id}', this.checked)"
                                 class="rounded text-emerald-600 cursor-pointer shrink-0">
                          <input type="text" value="${this.escapeAttr(t.text)}"
                                 onchange="app.updateTodoText('seance', '${seq.id}', '${sea.id}', '${t.id}', this.value)"
                                 class="flex-1 text-xs bg-transparent focus:outline-none ${t.done ? 'line-through text-stone-400' : 'text-stone-800'}">
                          <button onclick="app.deleteTodoItem('seance', '${seq.id}', '${sea.id}', '${t.id}')" class="opacity-0 group-hover:opacity-100 text-stone-400 hover:text-rose-600">
                            <i data-lucide="x" class="w-3.5 h-3.5"></i>
                          </button>
                        </div>
                      `).join('')}
                    </div>

                    <!-- Ajout rapide d'une tâche à la séance -->
                    <div class="flex gap-1.5 pt-1">
                      <input type="text" id="new-sea-todo-input" placeholder="Ajouter une tâche à cette séance..."
                             onkeydown="if(event.key==='Enter') app.addTodoItem('seance', '${seq.id}', '${sea.id}', 'new-sea-todo-input')"
                             class="flex-1 text-xs px-2.5 py-1.5 rounded-lg border border-stone-300 bg-white focus:outline-none">
                      <button onclick="app.addTodoItem('seance', '${seq.id}', '${sea.id}', 'new-sea-todo-input')" class="px-2.5 py-1.5 rounded-lg theme-accent-btn text-xs font-bold">+</button>
                    </div>
                  </div>
                `;
              }
            }

            const paDoneCount = seq.todos.filter(t => t.done).length;
            const paPct = seq.todos.length ? Math.round((paDoneCount / seq.todos.length) * 100) : 0;

            container.innerHTML = `
              ${seaSectionHtml}

              <!-- To-Do List du Projet d'Apprentissage (PA) -->
              <div class="theme-card p-3.5 border shadow-2xs space-y-3">
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 block">To-Do List du Projet (${seq.code})</span>
                    <h4 class="text-xs font-bold text-stone-900 truncate max-w-[210px]" title="${this.escapeAttr(seq.titre)}">${seq.titre}</h4>
                  </div>
                  <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900">${paDoneCount}/${seq.todos.length}</span>
                </div>

                <div class="w-full h-1.5 bg-stone-200 rounded-full overflow-hidden">
                  <div class="h-full bg-amber-600 transition-all" style="width: ${paPct}%"></div>
                </div>

                <div class="space-y-1.5">
                  ${seq.todos.map(t => `
                    <div class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-stone-50 border border-transparent hover:border-stone-200 group">
                      <input type="checkbox" ${t.done ? 'checked' : ''}
                             onchange="app.toggleTodoItem('sequence', '${seq.id}', null, '${t.id}', this.checked)"
                             class="rounded text-amber-600 cursor-pointer shrink-0">
                      <input type="text" value="${this.escapeAttr(t.text)}"
                             onchange="app.updateTodoText('sequence', '${seq.id}', null, '${t.id}', this.value)"
                             class="flex-1 text-xs bg-transparent focus:outline-none ${t.done ? 'line-through text-stone-400' : 'text-stone-800'}">
                      <button onclick="app.deleteTodoItem('sequence', '${seq.id}', null, '${t.id}')" class="opacity-0 group-hover:opacity-100 text-stone-400 hover:text-rose-600">
