      setTargetIcon(icon) {
        if (!this.coverTarget) return;
        const { type, seqId, seaId } = this.coverTarget;
        if (type === 'sequence') {
          const seq = this.getSequence(seqId);
          if (seq) seq.icon = icon;
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          if (sea) sea.icon = icon;
        }
        this.saveData();
        this.renderAll();
      },

      setTargetBanner(url) {
        if (!this.coverTarget) return;
        const { type, seqId, seaId } = this.coverTarget;
        if (type === 'sequence') {
          const seq = this.getSequence(seqId);
          if (seq) seq.banner = url;
        } else {
          const { sea } = this.getSeance(seqId, seaId);
          if (sea) sea.banner = url;
        }
        this.saveData();
        this.closeModal('cover-picker-modal');
        this.renderViewport();
      },

      uploadBannerForTarget(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target.result;
          this.data.assetBank.unshift({ id: 'ast-' + Date.now(), title: file.name, url: dataUrl });
